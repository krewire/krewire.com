<!doctype html>
<html lang="{lang || 'en'}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{title ? title + " — Krewire Docs" : "Krewire Documentation"}</title>
  <link rel="canonical" href="https://krewire.com/docs">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/krewire.css">
  <script src="/assets/krewire.js" defer></script>
</head>
<body class="docs-body">

  <!-- NAVBAR (Krewire UI) -->
  <Navbar showSidebarToggle=true showLangToggle=true gitHubURL="https://github.com/krewire/krewire">
    <div class="version-picker" id="versionPicker">
      <select id="docVersionSelect" aria-label="Documentation Version">
        <option value="v0.2.0" selected>v0.2.0 (latest)</option>
      </select>
    </div>

    <button class="topbar-search-btn" onclick="openSearchModal()" aria-label="Search Documentation">
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="7" cy="7" r="4.5"/><path d="M10.5 10.5L14 14"/></svg>
      <span>Search docs...</span>
      <kbd>⌘K</kbd>
    </button>

    <!-- Products Full-Width Mega Dropdown -->
    <details class="dropdown-container">
      <summary class="dropdown-trigger flex items-center gap-1.5 text-sm font-bold text-fg dark:text-fg-dark px-3 py-1.5 rounded-md hover:bg-bg-2 dark:hover:bg-bg-dark-2 hover:text-primary transition-all duration-150 cursor-pointer list-none select-none" aria-haspopup="true">
        <span data-i18n="nav.products">Products</span>
        <svg class="w-3.5 h-3.5 transition-transform duration-150 dropdown-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6l4 4 4-4"/></svg>
      </summary>
      <div class="dropdown-menu-fullwidth">
        <div class="container-site py-6 px-4 sm:px-6 lg:px-8">
          <div class="flex items-center justify-between pb-3 mb-4 border-b border-border-subtle">
            <div class="flex items-center gap-2">
              <span class="badge badge-primary text-2xs font-extrabold uppercase tracking-wider" data-i18n="nav.products_badge">Core Platforms</span>
              <span class="text-xs text-muted dark:text-muted-dark font-semibold hidden sm:inline" data-i18n="nav.products_tagline">One Ecosystem. Every Workload.</span>
            </div>
            <a href="/#ecosystem" class="text-xs font-bold text-fg dark:text-fg-dark hover:text-primary transition-colors flex items-center gap-1" data-i18n="nav.view_ecosystem_map">
              <span>Architecture Map</span>
              <span>→</span>
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 text-left">
            <a href="/docs/security-platforms/virtual-workspace" class="dropdown-product-card block p-4 rounded-xl no-underline group">
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="icon-box bg-primary text-primary-content text-base shrink-0 w-8 h-8 flex items-center justify-center font-black">⚡</span>
                <span class="text-[10px] badge badge-primary py-0.5 px-1.5 font-mono" data-i18n="nav.badge_ai">AI</span>
              </div>
              <div class="text-sm font-black text-fg dark:text-fg-dark group-hover:text-primary transition-colors flex items-center gap-1.5" data-i18n="products.workspace_title">
                Krewire Dash
              </div>
              <p class="text-xs text-muted dark:text-muted-dark leading-relaxed mt-1 mb-3" data-i18n="nav.workspace_desc">
                Virtual workspaces &amp; autonomous agents. Web terminal &amp; sandboxed runtimes.
              </p>
              <span class="text-[11px] font-bold text-primary flex items-center gap-1">dash.krewire.com ↗</span>
            </a>

            <a href="/docs/security-platforms/cloud-paas" class="dropdown-product-card block p-4 rounded-xl no-underline group">
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="icon-box bg-primary text-primary-content text-base shrink-0 w-8 h-8 flex items-center justify-center font-black">◈</span>
                <span class="text-[10px] badge badge-primary py-0.5 px-1.5 font-mono" data-i18n="nav.badge_paas">PaaS</span>
              </div>
              <div class="text-sm font-black text-fg dark:text-fg-dark group-hover:text-primary transition-colors flex items-center gap-1.5" data-i18n="products.cloud_title">
                Krewire Cloud
              </div>
              <p class="text-xs text-muted dark:text-muted-dark leading-relaxed mt-1 mb-3" data-i18n="nav.cloud_desc">
                Hybrid PaaS control plane &amp; zero-downtime blue-green deployments.
              </p>
              <span class="text-[11px] font-bold text-primary flex items-center gap-1">cloud.krewire.com ↗</span>
            </a>

            <a href="/docs/security-platforms/identity-and-auth" class="dropdown-product-card block p-4 rounded-xl no-underline group">
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="icon-box bg-primary text-primary-content text-base shrink-0 w-8 h-8 flex items-center justify-center font-bold">🛡</span>
                <span class="text-[10px] badge badge-primary py-0.5 px-1.5 font-mono" data-i18n="nav.badge_id">ID</span>
              </div>
              <div class="text-sm font-black text-fg dark:text-fg-dark group-hover:text-primary transition-colors flex items-center gap-1.5" data-i18n="products.auth_title">
                Krewire Auth
              </div>
              <p class="text-xs text-muted dark:text-muted-dark leading-relaxed mt-1 mb-3" data-i18n="nav.auth_desc">
                Multi-tenant SSO, MFA &amp; OIDC identity platform with SAML 2.0 &amp; RBAC.
              </p>
              <span class="text-[11px] font-bold text-primary flex items-center gap-1">auth.krewire.com ↗</span>
            </a>

            <a href="/docs/project/core-and-platform-services#krewire-panel" class="dropdown-product-card block p-4 rounded-xl no-underline group">
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="icon-box bg-primary text-primary-content text-base shrink-0 w-8 h-8 flex items-center justify-center font-bold">🎛</span>
                <span class="text-[10px] badge badge-primary py-0.5 px-1.5 font-mono" data-i18n="nav.badge_host">Host</span>
              </div>
              <div class="text-sm font-black text-fg dark:text-fg-dark group-hover:text-primary transition-colors flex items-center gap-1.5" data-i18n="products.panel_title">
                Krewire Panel
              </div>
              <p class="text-xs text-muted dark:text-muted-dark leading-relaxed mt-1 mb-3" data-i18n="nav.panel_desc">
                Self-hosted server &amp; admin control panel for bare-metal/VPS, systemd &amp; SSL.
              </p>
              <span class="text-[11px] font-bold text-primary flex items-center gap-1">panel.krewire.com ↗</span>
            </a>
          </div>

          <div class="pt-3.5 mt-2 border-t border-border-subtle flex flex-wrap items-center justify-between gap-3 text-xs text-left">
            <div class="flex flex-wrap items-center gap-3 sm:gap-4 text-muted dark:text-muted-dark font-medium">
              <span class="font-bold text-fg dark:text-fg-dark">Core Drivers:</span>
              <a href="/docs/getting-started" class="hover:text-primary transition-colors">CLI (<code class="code-inline">kiw</code>)</a>
              <span>·</span>
              <a href="/docs/getting-started/dsl" class="hover:text-primary transition-colors">Component DSL (<code class="code-inline">.kiw</code>)</a>
              <span>·</span>
              <a href="/#workloads" class="hover:text-primary transition-colors">8 Workloads</a>
              <span>·</span>
              <a href="https://github.com/krewire/krew" target="_blank" rel="noopener" class="hover:text-primary transition-colors">Krew AI Agent ↗</a>
            </div>
            <a href="/#products" class="font-extrabold text-primary hover:underline flex items-center gap-1" data-i18n="nav.view_all_products">
              View all Core Products →
            </a>
          </div>
        </div>
      </div>
    </details>

    <a class="nav-link font-bold text-primary" href="/docs">Docs</a>
    <a class="nav-link font-bold" href="/docs/project/contributing" data-i18n="nav.contribute">Contribute</a>

    <div slot="drawer">
      <button class="topbar-search-btn w-full mb-3" onclick="openSearchModal()" aria-label="Search Documentation">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="7" cy="7" r="4.5"/><path d="M10.5 10.5L14 14"/></svg>
        <span>Search docs...</span>
        <kbd>⌘K</kbd>
      </button>
      <div class="px-3 py-1.5 text-2xs font-black uppercase tracking-wider text-muted dark:text-muted-dark flex items-center justify-between border-b border-border-subtle mb-1">
        <span data-i18n="nav.products">Core Products</span>
        <span class="text-primary font-mono text-[10px]">4 Platforms</span>
      </div>
      <div class="flex flex-col gap-1.5 mb-2">
        <a href="/docs/security-platforms/virtual-workspace" class="mobile-link flex items-center justify-between p-2.5 rounded-lg border border-border-subtle bg-bg-2 dark:bg-bg-dark-2 hover:border-primary transition-all">
          <div class="flex items-center gap-2.5 min-w-0">
            <span class="icon-box bg-primary text-primary-content text-xs w-7 h-7 shrink-0 flex items-center justify-center font-bold">⚡</span>
            <div class="min-w-0">
              <div class="text-xs font-black text-fg dark:text-fg-dark truncate" data-i18n="products.workspace_title">Krewire Dash</div>
              <div class="text-[10px] text-muted dark:text-muted-dark leading-tight truncate" data-i18n="nav.workspace_desc">Virtual workspaces &amp; AI agents</div>
            </div>
          </div>
          <span class="text-2xs badge badge-primary py-0 px-1 font-mono shrink-0 ml-2" data-i18n="nav.badge_ai">AI</span>
        </a>
        <a href="/docs/security-platforms/cloud-paas" class="mobile-link flex items-center justify-between p-2.5 rounded-lg border border-border-subtle bg-bg-2 dark:bg-bg-dark-2 hover:border-primary transition-all">
          <div class="flex items-center gap-2.5 min-w-0">
            <span class="icon-box bg-primary text-primary-content text-xs w-7 h-7 shrink-0 flex items-center justify-center font-bold">◈</span>
            <div class="min-w-0">
              <div class="text-xs font-black text-fg dark:text-fg-dark truncate" data-i18n="products.cloud_title">Krewire Cloud</div>
              <div class="text-[10px] text-muted dark:text-muted-dark leading-tight truncate" data-i18n="nav.cloud_desc">Hybrid PaaS control plane</div>
            </div>
          </div>
          <span class="text-2xs badge badge-primary py-0 px-1 font-mono shrink-0 ml-2" data-i18n="nav.badge_paas">PaaS</span>
        </a>
        <a href="/docs/security-platforms/identity-and-auth" class="mobile-link flex items-center justify-between p-2.5 rounded-lg border border-border-subtle bg-bg-2 dark:bg-bg-dark-2 hover:border-primary transition-all">
          <div class="flex items-center gap-2.5 min-w-0">
            <span class="icon-box bg-primary text-primary-content text-xs w-7 h-7 shrink-0 flex items-center justify-center font-bold">🛡</span>
            <div class="min-w-0">
              <div class="text-xs font-black text-fg dark:text-fg-dark truncate" data-i18n="products.auth_title">Krewire Auth</div>
              <div class="text-[10px] text-muted dark:text-muted-dark leading-tight truncate" data-i18n="nav.auth_desc">SSO, MFA &amp; OIDC identity</div>
            </div>
          </div>
          <span class="text-2xs badge badge-primary py-0 px-1 font-mono shrink-0 ml-2" data-i18n="nav.badge_id">ID</span>
        </a>
        <a href="/docs/project/core-and-platform-services#krewire-panel" class="mobile-link flex items-center justify-between p-2.5 rounded-lg border border-border-subtle bg-bg-2 dark:bg-bg-dark-2 hover:border-primary transition-all">
          <div class="flex items-center gap-2.5 min-w-0">
            <span class="icon-box bg-primary text-primary-content text-xs w-7 h-7 shrink-0 flex items-center justify-center font-bold">🎛</span>
            <div class="min-w-0">
              <div class="text-xs font-black text-fg dark:text-fg-dark truncate" data-i18n="products.panel_title">Krewire Panel</div>
              <div class="text-[10px] text-muted dark:text-muted-dark leading-tight truncate" data-i18n="nav.panel_desc">Bare-metal server control panel</div>
            </div>
          </div>
          <span class="text-2xs badge badge-primary py-0 px-1 font-mono shrink-0 ml-2" data-i18n="nav.badge_host">Host</span>
        </a>
      </div>
      <a class="mobile-link flex items-center gap-2 px-3 py-2.5 rounded-lg font-bold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all text-primary" href="/docs">Documentation</a>
      <a class="mobile-link flex items-center gap-2 px-3 py-2.5 rounded-lg font-bold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all" href="/docs/project/contributing" data-i18n="nav.contribute">Contribute</a>
      <hr class="my-2" style="border-color:var(--pop-border); border-width:1.5px">
      <a class="mobile-link gh-mobile flex items-center gap-2 px-3 py-2.5 rounded-lg font-bold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all" href="https://github.com/krewire/krewire" target="_blank" rel="noopener">
        <span>GitHub ↗</span>
      </a>
    </div>
  </Navbar>

  <div class="docs-layout">
    <!-- LEFT SIDEBAR: HIERARCHICAL NAVIGATION -->
    <aside class="sidebar" id="sidebar" aria-label="Documentation Sidebar">
      <div class="sidebar-head">
        <span class="sidebar-title">Documentation</span>
        <button class="sidebar-close" id="sidebar-close" aria-label="Close navigation" onclick="document.documentElement.classList.remove('sidebar-open')">✕</button>
      </div>
      <nav class="toc" id="sidebar-toc">
        <div class="toc-group open" data-group>
          <div class="toc-parent-row">
            <a href="/docs/overview" class="toc-link">Overview</a>
          </div>
          <div class="toc-subs">
            <a href="/docs/overview/why-krewire" class="toc-sub">Why Krewire</a>
            <a href="/docs/overview/philosophy" class="toc-sub">Philosophy</a>
            <a href="/docs/overview/krewire-workloads" class="toc-sub">8 Workloads</a>
          </div>
        </div>

        <div class="toc-group open" data-group>
          <div class="toc-parent-row">
            <a href="/docs/getting-started" class="toc-link">Getting Started</a>
          </div>
          <div class="toc-subs">
            <a href="/docs/getting-started/installation" class="toc-sub">Installation</a>
            <a href="/docs/getting-started/configuration" class="toc-sub">Configuration</a>
            <a href="/docs/getting-started/directory-structure" class="toc-sub">Directory Structure</a>
            <a href="/docs/getting-started/dsl" class="toc-sub">.kiw DSL</a>
            <a href="/docs/getting-started/agentic-development" class="toc-sub">Agentic Development</a>
          </div>
        </div>

        <div class="toc-group open" data-group>
          <div class="toc-parent-row">
            <a href="/docs/workloads" class="toc-link">Workloads</a>
          </div>
          <div class="toc-subs">
            <a href="/docs/workloads/app" class="toc-sub">App</a>
            <a href="/docs/workloads/cli" class="toc-sub">CLI</a>
            <a href="/docs/workloads/site" class="toc-sub">Site</a>
            <a href="/docs/workloads/book" class="toc-sub">Book</a>
            <a href="/docs/workloads/worker" class="toc-sub">Worker</a>
            <a href="/docs/workloads/service" class="toc-sub">Service</a>
            <a href="/docs/workloads/gateway" class="toc-sub">Gateway</a>
            <a href="/docs/workloads/infra" class="toc-sub">Infra</a>
          </div>
        </div>

        <div class="toc-group open" data-group>
          <div class="toc-parent-row">
            <a href="/docs/core-libraries" class="toc-link">Core & Foundations</a>
          </div>
          <div class="toc-subs">
            <a href="/docs/core-libraries/model" class="toc-sub">Model & Primitives</a>
            <a href="/docs/core-libraries/lifecycle" class="toc-sub">Lifecycle Kernel</a>
            <a href="/docs/core-libraries/config" class="toc-sub">Configuration</a>
            <a href="/docs/core-libraries/validation" class="toc-sub">Validation</a>
            <a href="/docs/core-libraries/resilience" class="toc-sub">Resilience</a>
            <a href="/docs/core-libraries/testing" class="toc-sub">Testing Harness</a>
          </div>
        </div>

        <div class="toc-group open" data-group>
          <div class="toc-parent-row">
            <a href="/docs/web-ui" class="toc-link">Web & UI Framework</a>
          </div>
          <div class="toc-subs">
            <a href="/docs/web-ui/web" class="toc-sub">Web Engine</a>
            <a href="/docs/web-ui/app" class="toc-sub">Application Monolith</a>
            <a href="/docs/web-ui/web-runtime" class="toc-sub">Web Runtime & WASM</a>
            <a href="/docs/web-ui/ui" class="toc-sub">UI Components</a>
            <a href="/docs/web-ui/tui" class="toc-sub">Terminal UI</a>
          </div>
        </div>

        <div class="toc-group open" data-group>
          <div class="toc-parent-row">
            <a href="/docs/data-services" class="toc-link">Data & Services</a>
          </div>
          <div class="toc-subs">
            <a href="/docs/data-services/database-and-orm" class="toc-sub">Database & ORM</a>
            <a href="/docs/data-services/storage" class="toc-sub">Object Storage</a>
            <a href="/docs/data-services/filesystem" class="toc-sub">Virtual Filesystem</a>
            <a href="/docs/data-services/caching" class="toc-sub">Caching</a>
            <a href="/docs/data-services/mail" class="toc-sub">Transactional Mail</a>
            <a href="/docs/data-services/commerce-and-payments" class="toc-sub">Commerce & Payments</a>
          </div>
        </div>

        <div class="toc-group open" data-group>
          <div class="toc-parent-row">
            <a href="/docs/security-platforms" class="toc-link">Security & Platforms</a>
          </div>
          <div class="toc-subs">
            <a href="/docs/security-platforms/security" class="toc-sub">Security Controls</a>
            <a href="/docs/security-platforms/auth" class="toc-sub">Authentication</a>
            <a href="/docs/security-platforms/identity-and-auth" class="toc-sub">Identity & SSO</a>
            <a href="/docs/security-platforms/cloud-distributed" class="toc-sub">Distributed Systems</a>
            <a href="/docs/security-platforms/cloud-paas" class="toc-sub">Hybrid PaaS</a>
            <a href="/docs/security-platforms/ai-and-agents" class="toc-sub">AI Orchestration</a>
            <a href="/docs/security-platforms/autonomous-agent" class="toc-sub">Autonomous Agents</a>
            <a href="/docs/security-platforms/virtual-workspace" class="toc-sub">Virtual Workspace</a>
          </div>
        </div>

        <div class="toc-group open" data-group>
          <div class="toc-parent-row">
            <a href="/docs/cli-reference" class="toc-link">CLI Reference</a>
          </div>
          <div class="toc-subs">
            <a href="/docs/cli-reference/commands" class="toc-sub">Commands</a>
            <a href="/docs/cli-reference/configuration" class="toc-sub">Configuration</a>
            <a href="/docs/cli-reference/scripting" class="toc-sub">Scripting & CI/CD</a>
          </div>
        </div>

        <div class="toc-group open" data-group>
          <div class="toc-parent-row">
            <a href="/docs/guides" class="toc-link">Guides & Architecture</a>
          </div>
          <div class="toc-subs">
            <a href="/docs/architecture" class="toc-sub">Architecture Deep-Dive</a>
            <a href="/docs/guides/agentic-development" class="toc-sub">Agentic Development</a>
            <a href="/docs/guides/deployment-and-operations" class="toc-sub">Deployment & Operations</a>
            <a href="/docs/guides/hybrid-paas-and-cloud" class="toc-sub">Hybrid PaaS & Cloud</a>
            <a href="/docs/guides/open-core-and-licensing" class="toc-sub">Open Core & Licensing</a>
          </div>
        </div>
      </nav>
    </aside>
    <div class="sidebar-overlay" id="sidebar-overlay" aria-hidden="true" onclick="document.documentElement.classList.remove('sidebar-open')"></div>

    <!-- MAIN ARTICLE CONTENT -->
    <main class="docs-main">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span class="sep">/</span> <a href="/docs">Docs</a> <span class="sep">/</span> <span class="current">{title || "Documentation"}</span>
      </nav>

      <article class="chapter" id="docContent">
        {content}
      </article>

      <nav class="pager">
        <a class="prev" id="pagerPrev" href="/docs" style="display:none">&larr; Previous</a>
        <a class="next" id="pagerNext" href="/docs/getting-started" style="display:none">Next &rarr;</a>
      </nav>
    </main>

    <!-- RIGHT RAIL: ON THIS PAGE (SCROLLSPY TOC) -->
    <aside class="right-rail" aria-label="Table of contents">
      <div class="right-rail-title">On This Page</div>
      <nav class="right-rail-toc" id="rightRailTOC"></nav>
    </aside>
  </div>

  <!-- SEARCH MODAL COMPONENT -->
  <SearchModal />

</body>
</html>

<style>
.docs-body {
  margin: 0;
  background-color: var(--bg, #0B1F3B);
  color: var(--fg, #FAF8F4);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
.version-picker select {
  background: var(--bg-2, #112646);
  color: var(--fg, #FAF8F4);
  border: 1px solid var(--border-subtle, rgba(255,255,255,0.2));
  border-radius: 6px;
  padding: 0.25rem 0.5rem;
  font-size: 0.8rem;
  margin-left: 0.5rem;
  outline: none;
}
.topbar-search-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: var(--bg-2, #112646);
  border: 1px solid var(--border-subtle, rgba(255,255,255,0.2));
  color: var(--muted, #9ab0ce);
  padding: 0.35rem 0.85rem;
  border-radius: 8px;
  cursor: pointer;
  font-size: 0.85rem;
  margin-left: 1rem;
}
.topbar-search-btn kbd {
  background: rgba(0,0,0,0.2);
  padding: 0.1rem 0.35rem;
  border-radius: 4px;
  font-size: 0.75rem;
}
.docs-layout {
  display: flex;
  flex-direction: column;
  max-width: 1440px;
  margin: 0 auto;
  min-height: calc(100vh - 60px);
}
.sidebar {
  display: none;
}
.sidebar-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid var(--border-subtle, rgba(255,255,255,0.15));
}
.sidebar-close {
  display: none;
}
.sidebar-overlay {
  display: none;
}
.docs-main {
  flex: 1;
  min-width: 0;
  padding: 1.25rem 1rem;
}
.right-rail {
  display: none;
}

/* Tablet & Mobile Slide-Out Drawer when sidebar is toggled open (< 1024px) */
@media (max-width: 1023px) {
  html.sidebar-open .sidebar {
    display: block !important;
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: min(85vw, 20rem);
    max-width: 20rem;
    padding: 1.25rem 1.15rem 2.5rem;
    background: var(--bg, #0B1F3B);
    border-right: 2px solid var(--border-subtle, rgba(255,255,255,0.18));
    box-shadow: 4px 0 24px rgba(0,0,0,0.35);
    z-index: 100;
    overflow-y: auto;
    transform: translateX(0);
  }
  html.sidebar-open .sidebar-overlay {
    display: block;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(3px);
    z-index: 95;
  }
  .sidebar-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    border: 1px solid var(--border-subtle, rgba(255,255,255,0.2));
    background: var(--bg-2, #112646);
    color: var(--fg, #FAF8F4);
    font-size: 1rem;
    font-weight: 800;
    cursor: pointer;
  }
  .sidebar-close:hover {
    background: var(--error, #FF3B2E);
    color: #fff;
  }
}

/* Tablet Layout (768px - 1023px) */
@media (min-width: 768px) {
  .docs-layout {
    flex-direction: row;
  }
  .sidebar {
    display: block;
    width: 240px;
    flex-shrink: 0;
    border-right: 1px solid var(--border-subtle, rgba(255,255,255,0.1));
    padding: 1.5rem 0.85rem;
    position: sticky;
    top: 60px;
    height: calc(100vh - 60px);
    overflow-y: auto;
  }
  .sidebar-close {
    display: none !important;
  }
  .docs-main {
    padding: 1.75rem 2rem;
  }
}

/* Desktop Layout (1024px - 1279px) */
@media (min-width: 1024px) {
  .sidebar {
    width: 265px;
    padding: 1.75rem 1.15rem;
  }
  .docs-main {
    padding: 2rem 2.75rem;
  }
  .right-rail {
    display: block;
    width: 220px;
    flex-shrink: 0;
    padding: 2rem 1rem;
    position: sticky;
    top: 60px;
    height: calc(100vh - 60px);
    overflow-y: auto;
  }
}

/* Wide Desktop Layout (1280px+) */
@media (min-width: 1280px) {
  .sidebar {
    width: 290px;
    padding: 2.25rem 1.35rem;
  }
  .docs-main {
    padding: 2.25rem 3.5rem;
  }
  .right-rail {
    width: 250px;
    padding: 2.25rem 1.5rem;
  }
}
.right-rail-title {
  font-size: 0.8rem;
  text-transform: uppercase;
  font-weight: 700;
  color: var(--muted, #9ab0ce);
  margin-bottom: 0.75rem;
}
.right-rail-toc a {
  display: block;
  font-size: 0.85rem;
  color: var(--muted, #9ab0ce);
  text-decoration: none;
  padding: 0.3rem 0;
  transition: color 0.15s ease;
}
.right-rail-toc a:hover, .right-rail-toc a.active {
  color: var(--primary, #39D353);
  font-weight: 600;
}
.right-rail-toc a.toc-h3 {
  padding-left: 1rem;
  font-size: 0.8rem;
}
/* Terminal prompt highlighting */
.chapter pre code .terminal-prompt {
  color: #39D353;
  font-weight: bold;
}
</style>

<script>
// Right-Hand TOC Generator & Intersection Observer Scrollspy
document.addEventListener('DOMContentLoaded', () => {
  const article = document.getElementById('docContent');
  const tocContainer = document.getElementById('rightRailTOC');
  if (!article || !tocContainer) return;

  const headings = article.querySelectorAll('h2, h3');
  if (headings.length === 0) {
    tocContainer.innerHTML = '<span style="font-size:0.8rem; color:var(--muted)">No sub-sections</span>';
    return;
  }

  headings.forEach((h, i) => {
    if (!h.id) {
      h.id = 'heading-' + i + '-' + h.textContent.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-');
    }
    const a = document.createElement('a');
    a.href = '#' + h.id;
    a.innerText = h.textContent.replace(/#/g, '').trim();
    if (h.tagName.toLowerCase() === 'h3') {
      a.className = 'toc-h3';
    }
    tocContainer.appendChild(a);
  });

  // Scrollspy via IntersectionObserver
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        tocContainer.querySelectorAll('a').forEach(link => {
          link.classList.toggle('active', link.getAttribute('href') === '#' + id);
        });
      }
    });
  }, { rootMargin: '0px 0px -70% 0px' });

  headings.forEach(h => observer.observe(h));

  // Style terminal prompts ($) inside code blocks
  document.querySelectorAll('pre code').forEach(code => {
    if (code.innerText.includes('$ ')) {
      code.innerHTML = code.innerHTML.replace(/(^|\n)(\$\s)/g, '$1<span class="terminal-prompt">$2</span>');
    }
  });
});
</script>
