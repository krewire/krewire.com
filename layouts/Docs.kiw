</html>

<style>
.docs-body {
  margin: 0;
  background-color: var(--bg, #0B1F3B);
  color: var(--fg, #FAF8F4);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
.version-picker select {
  background: var(--bg-2, #112646);
  color: var(--fg, #FAF8F4);
  border: 1px solid var(--border-subtle, rgba(255,255,255,0.2));
  border-radius: 6px;
  padding: 0.25rem 0.5rem;
  font-size: 0.8rem;
  margin-left: 0.5rem;
  outline: none;
}
.topbar-search-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: var(--bg-2, #112646);
  border: 1px solid var(--border-subtle, rgba(255,255,255,0.2));
  color: var(--muted, #9ab0ce);
  padding: 0.35rem 0.85rem;
  border-radius: 8px;
  cursor: pointer;
  font-size: 0.85rem;
  margin-left: 1rem;
}
.topbar-search-btn kbd {
  background: rgba(0,0,0,0.2);
  padding: 0.1rem 0.35rem;
  border-radius: 4px;
  font-size: 0.75rem;
}
.docs-layout {
  display: flex;
  max-width: 1440px;
  margin: 0 auto;
  min-height: calc(100vh - 60px);
}
.sidebar {
  width: 280px;
  flex-shrink: 0;
  border-right: 1px solid var(--border-subtle, rgba(255,255,255,0.1));
  padding: 1.5rem 1rem;
}
.docs-main {
  flex: 1;
  min-width: 0;
  padding: 2rem 3rem;
}
.right-rail {
  width: 240px;
  flex-shrink: 0;
  padding: 2rem 1.5rem;
  position: sticky;
  top: 60px;
  height: calc(100vh - 60px);
  overflow-y: auto;
}
.right-rail-title {
  font-size: 0.8rem;
  text-transform: uppercase;
  font-weight: 700;
  color: var(--muted, #9ab0ce);
  margin-bottom: 0.75rem;
}
.right-rail-toc a {
  display: block;
  font-size: 0.85rem;
  color: var(--muted, #9ab0ce);
  text-decoration: none;
  padding: 0.3rem 0;
  transition: color 0.15s ease;
}
.right-rail-toc a:hover, .right-rail-toc a.active {
  color: var(--primary, #39D353);
  font-weight: 600;
}
.right-rail-toc a.toc-h3 {
  padding-left: 1rem;
  font-size: 0.8rem;
}
/* Terminal prompt highlighting */
.chapter pre code .terminal-prompt {
  color: #39D353;
  font-weight: bold;
}
</style>

<script>
// Right-Hand TOC Generator & Intersection Observer Scrollspy
document.addEventListener('DOMContentLoaded', () => {
  const article = document.getElementById('docContent');
  const tocContainer = document.getElementById('rightRailTOC');
  if (!article || !tocContainer) return;

  const headings = article.querySelectorAll('h2, h3');
  if (headings.length === 0) {
    tocContainer.innerHTML = '<span style="font-size:0.8rem; color:var(--muted)">No sub-sections</span>';
    return;
  }

  headings.forEach((h, i) => {
    if (!h.id) {
      h.id = 'heading-' + i + '-' + h.textContent.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-');
    }
    const a = document.createElement('a');
    a.href = '#' + h.id;
    a.innerText = h.textContent.replace(/#/g, '').trim();
    if (h.tagName.toLowerCase() === 'h3') {
      a.className = 'toc-h3';
    }
    tocContainer.appendChild(a);
  });

  // Scrollspy via IntersectionObserver
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        tocContainer.querySelectorAll('a').forEach(link => {
          link.classList.toggle('active', link.getAttribute('href') === '#' + id);
        });
      }
    });
  }, { rootMargin: '0px 0px -70% 0px' });

  headings.forEach(h => observer.observe(h));

  // Style terminal prompts ($) inside code blocks
  document.querySelectorAll('pre code').forEach(code => {
    if (code.innerText.includes('$ ')) {
      code.innerHTML = code.innerHTML.replace(/(^|\n)(\$\s)/g, '$1<span class="terminal-prompt">$2</span>');
    }
  });
});
</script>
