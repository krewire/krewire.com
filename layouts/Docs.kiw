<!doctype html>
<html lang="{lang || 'en'}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{title ? title + " — Krewire Docs" : "Krewire Documentation"}</title>
  <link rel="canonical" href="https://krewire.com/docs">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/krewire.css">
  <script src="/assets/krewire.js" defer></script>
</head>
<body class="docs-body">

  <!-- NAVBAR (Krewire UI) -->
  <Navbar showSidebarToggle=true showLangToggle=true gitHubURL="https://github.com/krewire/krewire">
    <div class="version-picker" id="versionPicker">
      <select id="docVersionSelect" aria-label="Documentation Version">
        <option value="v0.2.0" selected>v0.2.0 (latest)</option>
      </select>
    </div>

    <button class="topbar-search-btn" onclick="openSearchModal()" aria-label="Search Documentation">
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="7" cy="7" r="4.5"/><path d="M10.5 10.5L14 14"/></svg>
      <span>Search docs...</span>
      <kbd>⌘K</kbd>
    </button>

    <!-- Products Dropdown -->
    <details class="relative group dropdown-container inline-block">
      <summary class="dropdown-trigger flex items-center gap-1.5 text-sm font-bold text-fg dark:text-fg-dark px-3 py-1.5 rounded-md hover:bg-bg-2 dark:hover:bg-bg-dark-2 hover:text-primary transition-all duration-150 cursor-pointer list-none select-none" aria-haspopup="true">
        <span data-i18n="nav.products">Products</span>
        <svg class="w-3.5 h-3.5 transition-transform duration-150 dropdown-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6l4 4 4-4"/></svg>
      </summary>
      <div class="dropdown-menu absolute left-0 top-full pt-1.5 z-50">
        <div class="w-72 bg-bg dark:bg-bg-dark p-2 rounded-xl flex flex-col gap-1 border-pop" style="border:var(--pop-border); box-shadow:var(--pop-shadow)">
          <a href="https://dash.krewire.com" target="_blank" rel="noopener" class="flex items-start gap-3 p-2.5 rounded-lg hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-colors">
            <span class="icon-box bg-primary text-primary-content text-sm shrink-0" style="width:30px;height:30px">⚡</span>
            <div>
              <div class="text-xs font-black text-fg dark:text-fg-dark flex items-center gap-1.5">
                <span data-i18n="products.workspace_title">Krewire Workspace</span>
                <span class="text-[9px] badge badge-primary py-0 px-1" data-i18n="nav.badge_ai">AI</span>
              </div>
              <div class="text-[11px] text-muted dark:text-muted-dark leading-snug mt-0.5" data-i18n="nav.workspace_desc">Virtual workspaces &amp; autonomous agents</div>
            </div>
          </a>
          <a href="https://cloud.krewire.com" target="_blank" rel="noopener" class="flex items-start gap-3 p-2.5 rounded-lg hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-colors">
            <span class="icon-box bg-primary text-primary-content text-sm shrink-0" style="width:30px;height:30px">◈</span>
            <div>
              <div class="text-xs font-black text-fg dark:text-fg-dark flex items-center gap-1.5">
                <span data-i18n="products.cloud_title">Krewire Cloud</span>
                <span class="text-[9px] badge badge-primary py-0 px-1" data-i18n="nav.badge_paas">PaaS</span>
              </div>
              <div class="text-[11px] text-muted dark:text-muted-dark leading-snug mt-0.5" data-i18n="nav.cloud_desc">Hybrid PaaS control plane &amp; zero-downtime</div>
            </div>
          </a>
          <a href="https://auth.krewire.com" target="_blank" rel="noopener" class="flex items-start gap-3 p-2.5 rounded-lg hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-colors">
            <span class="icon-box bg-primary text-primary-content text-sm shrink-0" style="width:30px;height:30px">🛡</span>
            <div>
              <div class="text-xs font-black text-fg dark:text-fg-dark flex items-center gap-1.5">
                <span data-i18n="products.auth_title">Krewire Auth</span>
                <span class="text-[9px] badge badge-primary py-0 px-1" data-i18n="nav.badge_id">ID</span>
              </div>
              <div class="text-[11px] text-muted dark:text-muted-dark leading-snug mt-0.5" data-i18n="nav.auth_desc">Multi-tenant SSO, MFA &amp; OIDC identity</div>
            </div>
          </a>
          <a href="https://panel.krewire.com" target="_blank" rel="noopener" class="flex items-start gap-3 p-2.5 rounded-lg hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-colors">
            <span class="icon-box bg-primary text-primary-content text-sm shrink-0" style="width:30px;height:30px">🎛</span>
            <div>
              <div class="text-xs font-black text-fg dark:text-fg-dark flex items-center gap-1.5">
                <span data-i18n="products.panel_title">Krewire Panel</span>
                <span class="text-[9px] badge badge-primary py-0 px-1" data-i18n="nav.badge_host">Host</span>
              </div>
              <div class="text-[11px] text-muted dark:text-muted-dark leading-snug mt-0.5" data-i18n="nav.panel_desc">Self-hosted server &amp; admin control panel</div>
            </div>
          </a>
          <div class="pt-1 mt-1 border-t border-border-subtle">
            <a href="/#products" class="flex items-center justify-between px-2.5 py-1.5 rounded-md text-xs font-bold text-fg dark:text-fg-dark hover:bg-bg-2 dark:hover:bg-bg-dark-2 hover:text-primary transition-colors">
              <span data-i18n="nav.view_all_products">View all Core Products →</span>
            </a>
          </div>
        </div>
      </div>
    </details>

    <a class="nav-link font-bold text-primary" href="/docs">Docs</a>

    <div slot="drawer">
      <button class="topbar-search-btn w-full mb-3" onclick="openSearchModal()" aria-label="Search Documentation">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="7" cy="7" r="4.5"/><path d="M10.5 10.5L14 14"/></svg>
        <span>Search docs...</span>
        <kbd>⌘K</kbd>
      </button>
      <div class="px-3 py-1 text-2xs font-black uppercase tracking-wider text-muted dark:text-muted-dark flex items-center justify-between" data-i18n="nav.products">
        <span>Products</span>
        <span>↓</span>
      </div>
      <a href="https://dash.krewire.com" target="_blank" rel="noopener" class="mobile-link flex items-center justify-between px-3 py-2.5 rounded-lg font-bold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all">
        <span class="flex items-center gap-2.5">
          <span class="icon-box bg-primary text-primary-content text-xs w-6 h-6 shrink-0 flex items-center justify-center">⚡</span>
          <span data-i18n="products.workspace_title">Krewire Workspace</span>
        </span>
        <span class="text-2xs badge badge-primary" data-i18n="nav.badge_ai">AI</span>
      </a>
      <a href="https://cloud.krewire.com" target="_blank" rel="noopener" class="mobile-link flex items-center justify-between px-3 py-2.5 rounded-lg font-bold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all">
        <span class="flex items-center gap-2.5">
          <span class="icon-box bg-primary text-primary-content text-xs w-6 h-6 shrink-0 flex items-center justify-center">◈</span>
          <span data-i18n="products.cloud_title">Krewire Cloud</span>
        </span>
        <span class="text-2xs badge badge-primary" data-i18n="nav.badge_paas">PaaS</span>
      </a>
      <a href="https://auth.krewire.com" target="_blank" rel="noopener" class="mobile-link flex items-center justify-between px-3 py-2.5 rounded-lg font-bold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all">
        <span class="flex items-center gap-2.5">
          <span class="icon-box bg-primary text-primary-content text-xs w-6 h-6 shrink-0 flex items-center justify-center">🛡</span>
          <span data-i18n="products.auth_title">Krewire Auth</span>
        </span>
        <span class="text-2xs badge badge-primary" data-i18n="nav.badge_id">ID</span>
      </a>
      <a href="https://panel.krewire.com" target="_blank" rel="noopener" class="mobile-link flex items-center justify-between px-3 py-2.5 rounded-lg font-bold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all">
        <span class="flex items-center gap-2.5">
          <span class="icon-box bg-primary text-primary-content text-xs w-6 h-6 shrink-0 flex items-center justify-center">🎛</span>
          <span data-i18n="products.panel_title">Krewire Panel</span>
        </span>
        <span class="text-2xs badge badge-primary" data-i18n="nav.badge_host">Host</span>
      </a>
      <a class="mobile-link flex items-center gap-2 px-3 py-2.5 rounded-lg font-bold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all text-primary" href="/docs">Documentation</a>
      <hr class="my-2" style="border-color:var(--pop-border); border-width:1.5px">
      <a class="mobile-link gh-mobile flex items-center gap-2 px-3 py-2.5 rounded-lg font-bold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all" href="https://github.com/krewire/krewire" target="_blank" rel="noopener">
        <span>GitHub ↗</span>
      </a>
    </div>
  </Navbar>

  <div class="docs-layout">
    <!-- LEFT SIDEBAR: HIERARCHICAL NAVIGATION -->
    <aside class="sidebar" id="sidebar" aria-label="Documentation Sidebar">
      <div class="sidebar-head">
        <span class="sidebar-title">Documentation</span>
      </div>
      <nav class="toc" id="sidebar-toc">
        <div class="toc-group open" data-group>
          <div class="toc-parent-row">
            <a href="/docs/overview" class="toc-link">Overview</a>
          </div>
          <div class="toc-subs">
            <a href="/docs/overview/why-krewire" class="toc-sub">Why Krewire</a>
            <a href="/docs/overview/philosophy" class="toc-sub">Philosophy</a>
            <a href="/docs/overview/krewire-workloads" class="toc-sub">8 Workloads</a>
          </div>
        </div>

        <div class="toc-group open" data-group>
          <div class="toc-parent-row">
            <a href="/docs/getting-started" class="toc-link">Getting Started</a>
          </div>
          <div class="toc-subs">
            <a href="/docs/getting-started/installation" class="toc-sub">Installation</a>
            <a href="/docs/getting-started/configuration" class="toc-sub">Configuration</a>
            <a href="/docs/getting-started/directory-structure" class="toc-sub">Directory Structure</a>
            <a href="/docs/getting-started/dsl" class="toc-sub">.kiw DSL</a>
            <a href="/docs/getting-started/agentic-development" class="toc-sub">Agentic Development</a>
          </div>
        </div>

        <div class="toc-group open" data-group>
          <div class="toc-parent-row">
            <a href="/docs/workloads" class="toc-link">Workloads</a>
          </div>
          <div class="toc-subs">
            <a href="/docs/workloads/app" class="toc-sub">App</a>
            <a href="/docs/workloads/cli" class="toc-sub">CLI</a>
            <a href="/docs/workloads/site" class="toc-sub">Site</a>
            <a href="/docs/workloads/book" class="toc-sub">Book</a>
            <a href="/docs/workloads/worker" class="toc-sub">Worker</a>
            <a href="/docs/workloads/service" class="toc-sub">Service</a>
            <a href="/docs/workloads/gateway" class="toc-sub">Gateway</a>
            <a href="/docs/workloads/infra" class="toc-sub">Infra</a>
          </div>
        </div>

        <div class="toc-group open" data-group>
          <div class="toc-parent-row">
            <a href="/docs/core-libraries" class="toc-link">Core & Foundations</a>
          </div>
          <div class="toc-subs">
            <a href="/docs/core-libraries/model" class="toc-sub">Model & Primitives</a>
            <a href="/docs/core-libraries/lifecycle" class="toc-sub">Lifecycle Kernel</a>
            <a href="/docs/core-libraries/config" class="toc-sub">Configuration</a>
            <a href="/docs/core-libraries/validation" class="toc-sub">Validation</a>
            <a href="/docs/core-libraries/resilience" class="toc-sub">Resilience</a>
            <a href="/docs/core-libraries/testing" class="toc-sub">Testing Harness</a>
          </div>
        </div>

        <div class="toc-group open" data-group>
          <div class="toc-parent-row">
            <a href="/docs/web-ui" class="toc-link">Web & UI Framework</a>
          </div>
          <div class="toc-subs">
            <a href="/docs/web-ui/web" class="toc-sub">Web Engine</a>
            <a href="/docs/web-ui/app" class="toc-sub">Application Monolith</a>
            <a href="/docs/web-ui/web-runtime" class="toc-sub">Web Runtime & WASM</a>
            <a href="/docs/web-ui/ui" class="toc-sub">UI Components</a>
            <a href="/docs/web-ui/tui" class="toc-sub">Terminal UI</a>
          </div>
        </div>

        <div class="toc-group open" data-group>
          <div class="toc-parent-row">
            <a href="/docs/data-services" class="toc-link">Data & Services</a>
          </div>
          <div class="toc-subs">
            <a href="/docs/data-services/database-and-orm" class="toc-sub">Database & ORM</a>
            <a href="/docs/data-services/storage" class="toc-sub">Object Storage</a>
            <a href="/docs/data-services/filesystem" class="toc-sub">Virtual Filesystem</a>
            <a href="/docs/data-services/caching" class="toc-sub">Caching</a>
            <a href="/docs/data-services/mail" class="toc-sub">Transactional Mail</a>
            <a href="/docs/data-services/commerce-and-payments" class="toc-sub">Commerce & Payments</a>
          </div>
