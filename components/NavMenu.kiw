                <span>Architecture Map</span>
                <span>→</span>
              </a>
            </div>

            <!-- 4 Products Responsive Grid (1 col on mobile, 2 col on md, 4 col on lg) -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">

              <!-- 1. Krewire Dash -->
              <a href="/docs/security-platforms/virtual-workspace" class="dropdown-product-card block p-4 rounded-xl no-underline group">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="icon-box bg-primary text-primary-content text-base shrink-0 w-8 h-8 flex items-center justify-center font-black">⚡</span>
                  <Badge Variant="primary" Size="sm" Class="font-mono"><span data-i18n="nav.badge_ai">AI</span></Badge>
                </div>
