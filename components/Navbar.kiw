<header class="sticky top-0 z-50 bg-bg dark:bg-bg-dark w-full navbar relative" style="border: none !important; border-top: none !important; border-left: none !important; border-right: none !important; border-bottom: var(--pop-border, 2.5px solid var(--border)) !important;">
  <div class="container-site flex items-center justify-between gap-3 py-3.5">
    <div class="flex items-center gap-3 min-w-0">
      {#if showSidebarToggle}
      <Hamburger ID="site-sidebar-toggle" Label="Open navigation" Controls="site-sidebar" DataDrawerToggle="site-sidebar" Class="lg:hidden sidebar-toggle shrink-0" />
      {/if}
      {#if brand}
        {brand}
      {:else}
        <Brand Name={brandName} Href={brandHref} Icon={brandIcon} {version} Badge={brandBadge} BadgeI18n={brandBadgeI18n} />
      {/if}
    </div>

    <!-- Main / Desktop navigation slot -->
    <div class="ml-auto hidden md:flex items-center gap-1 nav-menu">
      {#if showEcosystemMenu}
        {#if body}
          <NavMenu showEcosystemMenu=true showProductsDropdown=true hideLinks=true />
        {:else}
          <NavMenu showEcosystemMenu=true showProductsDropdown=true />
        {/if}
      {/if}
      {#if body}
        {body}
      {:else if navLinks}
        {#each navLinks as link}
          <a href="{link.url}" class="text-sm font-bold text-fg dark:text-fg-dark px-3 py-1.5 rounded-md hover:bg-bg-2 dark:hover:bg-bg-dark-2 hover:text-primary transition-all duration-150">{link.text}</a>
        {/each}
      {:else if items}
        {#each items as link}
          <a href="{link.url}" class="text-sm font-bold text-fg dark:text-fg-dark px-3 py-1.5 rounded-md hover:bg-bg-2 dark:hover:bg-bg-dark-2 hover:text-primary transition-all duration-150">{link.text}</a>
        {/each}
      {/if}
    </div>

    <div class="flex items-center gap-2 shrink-0">
      {#if actions}
        {actions}
      {:else if actionHref}
        <a href="{actionHref}" class="btn btn-primary text-xs px-3.5 py-1.5 min-h-0 font-bold shadow-[1.5px_1.5px_0px_var(--border)]">{#if actionLabel}{actionLabel}{:else}Action →{/if}</a>
      {/if}
      {#if showLangToggle}
      <LangSwitch />
      {/if}
      {#if !hideGitHub && gitHubURL}
      <a href="{gitHubURL}" target="_blank" rel="noopener"
         class="hidden lg:inline-flex items-center gap-1.5 btn btn-primary text-xs px-3.5 py-1.5 min-h-0 shadow-[1.5px_1.5px_0px_var(--border)]">
        <span>★</span><span>GitHub</span>
      </a>
      {/if}
      <ThemeSwitch />
      <Hamburger ID="nav-toggler" Label="Toggle menu" Controls="nav-mobile-menu" DataDrawerToggle="nav-mobile-menu" Class="md:hidden shrink-0" />
    </div>
  </div>

  <!-- Mobile navigation drawer -->
  <div id="nav-mobile-menu" class="drawer drawer-right md:hidden" role="dialog" aria-modal="true" aria-label="Menu" data-kiw-component="Drawer">
    <div class="drawer-panel max-w-sm sm:max-w-md w-full">
      <div class="drawer-head">
        <div class="drawer-title-area">
          <h3 class="drawer-title">Menu</h3>
        </div>
        <button type="button" class="drawer-close" aria-label="Close drawer" data-drawer-close="nav-mobile-menu">
          ✕
        </button>
      </div>

      <div class="drawer-body">
        <div class="flex flex-col gap-1.5 mobile-nav-items">
          {#if actionHref}
            <div class="px-1 pt-1 pb-2">
              <a href="{actionHref}" class="btn btn-primary w-full justify-center min-h-[42px] text-sm font-bold shadow-[2px_2px_0px_var(--border)]">{#if actionLabel}{actionLabel}{:else}Action →{/if}</a>
            </div>
            <hr class="my-2" style="border-color:var(--pop-border); border-width:1.5px">
          {/if}
          {#if drawer}
            {drawer}
          {:else if drawerBody}
            {drawerBody}
          {:else}
            {#if showEcosystemMenu}
              <div class="px-3 py-1.5 text-2xs font-black uppercase tracking-wider text-muted dark:text-muted-dark flex items-center justify-between border-b border-border-subtle mb-1">
                <span data-i18n="nav.ecosystem">Krewire Ecosystem</span>
                <span class="text-primary font-mono text-[10px]">4 Platforms</span>
              </div>

              <div class="flex flex-col gap-1.5 mb-2">
                <a href="https://dash.krewire.com" target="_blank" rel="noopener" class="mobile-link flex items-center justify-between p-2.5 rounded-lg border border-border-subtle bg-bg-2 dark:bg-bg-dark-2 hover:border-primary transition-all">
                  <div class="flex items-center gap-2.5 min-w-0">
                    <span class="icon-box bg-primary text-primary-content text-xs w-7 h-7 shrink-0 flex items-center justify-center font-bold">⚡</span>
                    <div class="min-w-0">
                      <div class="text-xs font-black text-fg dark:text-fg-dark truncate" data-i18n="products.workspace_title">Krewire Dash</div>
                      <div class="text-[10px] text-muted dark:text-muted-dark leading-tight truncate" data-i18n="nav.workspace_desc">Virtual workspaces &amp; AI agents</div>
                    </div>
                  </div>
                  <span class="text-2xs badge badge-primary py-0 px-1 font-mono shrink-0 ml-2" data-i18n="nav.badge_ai">AI</span>
                </a>

                <a href="https://cloud.krewire.com" target="_blank" rel="noopener" class="mobile-link flex items-center justify-between p-2.5 rounded-lg border border-border-subtle bg-bg-2 dark:bg-bg-dark-2 hover:border-primary transition-all">
                  <div class="flex items-center gap-2.5 min-w-0">
                    <span class="icon-box bg-primary text-primary-content text-xs w-7 h-7 shrink-0 flex items-center justify-center font-bold">◈</span>
                    <div class="min-w-0">
                      <div class="text-xs font-black text-fg dark:text-fg-dark truncate" data-i18n="products.cloud_title">Krewire Cloud</div>
                      <div class="text-[10px] text-muted dark:text-muted-dark leading-tight truncate" data-i18n="nav.cloud_desc">Hybrid PaaS control plane</div>
                    </div>
                  </div>
                  <span class="text-2xs badge badge-primary py-0 px-1 font-mono shrink-0 ml-2" data-i18n="nav.badge_paas">PaaS</span>
                </a>

                <a href="https://auth.krewire.com" target="_blank" rel="noopener" class="mobile-link flex items-center justify-between p-2.5 rounded-lg border border-border-subtle bg-bg-2 dark:bg-bg-dark-2 hover:border-primary transition-all">
                  <div class="flex items-center gap-2.5 min-w-0">
                    <span class="icon-box bg-primary text-primary-content text-xs w-7 h-7 shrink-0 flex items-center justify-center font-bold">🛡</span>
                    <div class="min-w-0">
                      <div class="text-xs font-black text-fg dark:text-fg-dark truncate" data-i18n="products.auth_title">Krewire Auth</div>
                      <div class="text-[10px] text-muted dark:text-muted-dark leading-tight truncate" data-i18n="nav.auth_desc">SSO, MFA &amp; OIDC identity</div>
                    </div>
                  </div>
                  <span class="text-2xs badge badge-primary py-0 px-1 font-mono shrink-0 ml-2" data-i18n="nav.badge_id">ID</span>
                </a>

                <a href="https://forge.krewire.com" target="_blank" rel="noopener" class="mobile-link flex items-center justify-between p-2.5 rounded-lg border border-border-subtle bg-bg-2 dark:bg-bg-dark-2 hover:border-primary transition-all">
                  <div class="flex items-center gap-2.5 min-w-0">
                    <span class="icon-box bg-primary text-primary-content text-xs w-7 h-7 shrink-0 flex items-center justify-center font-bold">🛠</span>
                    <div class="min-w-0">
                      <div class="text-xs font-black text-fg dark:text-fg-dark truncate" data-i18n="products.forge_title">Krewire Forge</div>
                      <div class="text-[10px] text-muted dark:text-muted-dark leading-tight truncate" data-i18n="nav.forge_desc">Web, form &amp; panel builder</div>
                    </div>
                  </div>
                  <span class="text-2xs badge badge-primary py-0 px-1 font-mono shrink-0 ml-2" data-i18n="nav.badge_forge">Forge</span>
                </a>
              </div>

              <hr class="my-2" style="border-color:var(--pop-border); border-width:1.5px">
            {/if}

            {#if body}
              {body}
            {:else if navLinks}
              {#each navLinks as link}
                <a href="{link.url}" class="mobile-link flex items-center gap-2 px-3 py-2.5 rounded-lg font-bold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all">{link.text}</a>
              {/each}
            {:else if items}
              {#each items as link}
                <a href="{link.url}" class="mobile-link flex items-center gap-2 px-3 py-2.5 rounded-lg font-bold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all">{link.text}</a>
              {/each}
            {:else if showEcosystemMenu}
              <a href="https://krewire.com/docs/getting-started" class="mobile-link flex items-center gap-3 px-3 py-2.5 rounded-lg font-extrabold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all">
                <span class="text-primary w-4 font-black">›</span> <span data-i18n="nav.get_started">Get Started</span>
              </a>
              <a href="https://krewire.com/docs/getting-started/dsl" class="mobile-link flex items-center gap-3 px-3 py-2.5 rounded-lg font-extrabold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all">
                <span class="text-primary w-4 font-black">◈</span> <span data-i18n="nav.dsl">Component DSL</span>
              </a>
              <a href="https://krewire.com/docs" class="mobile-link flex items-center gap-3 px-3 py-2.5 rounded-lg font-extrabold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all">
                <span class="text-primary w-4 font-black">≡</span> <span data-i18n="nav.docs">Documentation</span>
              </a>
              <a href="https://krewire.com/#ecosystem" class="mobile-link flex items-center gap-3 px-3 py-2.5 rounded-lg font-extrabold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all">
                <span class="text-primary w-4 font-black">⬢</span> <span data-i18n="nav.ecosystem">Ecosystem</span>
              </a>
              <a href="https://github.com/krewire/krewire" target="_blank" rel="noopener" class="mobile-link flex items-center gap-3 px-3 py-2.5 rounded-lg font-extrabold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all">
                <span class="text-primary w-4 font-black">★</span> <span>GitHub Repository ↗</span>
              </a>
            {/if}
          {/if}
        </div>
      </div>
    </div>
  </div>
  <div id="nav-mobile-menu-backdrop" class="drawer-backdrop md:hidden" data-drawer-backdrop="nav-mobile-menu" aria-hidden="true"></div>
</header>

<script>
if (typeof window !== 'undefined' && !window.__kuiDropdownListenerInstalled) {
  window.__kuiDropdownListenerInstalled = true;
  document.addEventListener('click', function(e) {
    var details = document.querySelectorAll('details.dropdown-container[open]');
    for (var i = 0; i < details.length; i++) {
      if (!details[i].contains(e.target)) {
        details[i].removeAttribute('open');
      }
    }
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      var details = document.querySelectorAll('details.dropdown-container[open]');
      for (var i = 0; i < details.length; i++) {
        details[i].removeAttribute('open');
      }
    }
  });
}
</script>

<style>
/* Navbar border and consistent vertical padding */
.navbar,
header.navbar {
  border: none !important;
  border-top: none !important;
  border-left: none !important;
  border-right: none !important;
  border-bottom: var(--pop-border, 2.5px solid var(--border, #0B1F3B)) !important;
}

:root[data-theme="dark"] .navbar,
html[data-theme="dark"] .navbar,
.dark .navbar {
  border-bottom: var(--pop-border, 2.5px solid var(--border, #FAF8F4)) !important;
}

.navbar .container-site {
  padding-top: 0.875rem !important;
  padding-bottom: 0.875rem !important;
}

/* Large screen / desktop nav menu display */
.nav-menu {
  display: none;
}

@media (min-width: 768px) {
  .nav-menu,
  div.nav-menu,
  nav.nav-menu,
  .navbar .nav-menu {
    display: flex !important;
    align-items: center;
  }
}
</style>
