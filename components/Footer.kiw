<footer class="bg-bg-2 dark:bg-bg-dark-2 w-full footer-site {class}" style="border-top:var(--pop-border)" data-kiw-component="Footer">
  <div class="container-site pt-12 pb-10 sm:pt-14 sm:pb-12 lg:pt-16 lg:pb-14">
    
    <!-- Top Section: Brand Identity & Social Connect (Full Width) -->
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-8 pb-10 sm:pb-12" style="border-bottom:var(--pop-border-thin)">
      
      <!-- Brand & Value Propositions -->
      <div class="flex flex-col items-start max-w-xl">
        <div class="flex items-center gap-2.5 font-black text-2xl mb-3">
          <span class="icon-box bg-primary text-primary-content w-9 h-9 text-base flex items-center justify-center font-bold">◈</span>
          <span class="tracking-tight text-fg dark:text-fg-dark">Krewire</span>
          <Badge Variant="secondary" Size="sm" Class="ml-1.5 font-mono">{#if version}{version}{:else}v0.2.3{/if}</Badge>
        </div>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed mb-4" data-i18n-html="footer.tagline_html">
          The Complete Go SDLC Platform.<br>
          <span class="text-fg dark:text-fg-dark font-bold">One Ecosystem. Every Workload.</span>
        </p>

        <!-- Value Proposition Badges -->
        <div class="flex flex-wrap gap-2">
          <Badge Variant="neutral" Size="sm" Class="font-mono text-2xs">100% Pure Go</Badge>
          <Badge Variant="neutral" Size="sm" Class="font-mono text-2xs">Pure Go · Standalone Binary</Badge>
          <Badge Variant="neutral" Size="sm" Class="font-mono text-2xs">MIT Open Core</Badge>
          <Badge Variant="neutral" Size="sm" Class="font-mono text-2xs">CGO_ENABLED=0</Badge>
        </div>
      </div>

      <!-- Connect & Social Box -->
      <div class="flex flex-col items-start lg:items-end gap-3">
        <span class="text-2xs font-mono font-bold uppercase tracking-wider text-muted dark:text-muted-dark">Connect &amp; Social</span>
        <div class="flex items-center gap-2.5">
          <!-- Email -->
          <a href="mailto:hello@krewire.com" class="social-icon-btn flex items-center justify-center w-10 h-10 rounded-xl border-2 border-border bg-bg dark:bg-bg-dark text-fg dark:text-fg-dark hover:bg-primary hover:text-primary-content transition-all shadow-[2px_2px_0px_var(--border)] hover:-translate-y-0.5" title="Email: hello@krewire.com" aria-label="Email hello@krewire.com">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </a>
          <!-- GitHub -->
          <a href="https://github.com/krewire" target="_blank" rel="noopener" class="social-icon-btn flex items-center justify-center w-10 h-10 rounded-xl border-2 border-border bg-bg dark:bg-bg-dark text-fg dark:text-fg-dark hover:bg-primary hover:text-primary-content transition-all shadow-[2px_2px_0px_var(--border)] hover:-translate-y-0.5" title="GitHub: @krewire" aria-label="GitHub Profile">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
          </a>
          <!-- Instagram -->
          <a href="https://instagram.com/krewire" target="_blank" rel="noopener" class="social-icon-btn flex items-center justify-center w-10 h-10 rounded-xl border-2 border-border bg-bg dark:bg-bg-dark text-fg dark:text-fg-dark hover:bg-primary hover:text-primary-content transition-all shadow-[2px_2px_0px_var(--border)] hover:-translate-y-0.5" title="Instagram: @krewire" aria-label="Instagram Profile">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          </a>
        </div>
        <a href="mailto:hello@krewire.com" class="text-xs font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center gap-1.5">
          <span>✉</span> <span>hello@krewire.com</span>
        </a>
      </div>
    </div>

    <!-- Navigation Columns Grid: 4 spacious columns (25% width each on lg) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 py-10 sm:py-12" style="border-bottom:var(--pop-border-thin)">
      
      <!-- Col 1: 8 Workloads -->
      <div class="flex flex-col gap-3">
        <div class="flex items-center gap-2 mb-1">
          <span class="text-xs font-mono font-bold text-primary">01.</span>
          <strong class="text-xs font-mono font-bold uppercase tracking-wider text-fg dark:text-fg-dark" data-i18n="footer.workloads_title">8 Workloads</strong>
        </div>
        <a href="/docs/workloads/app" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between group">
          <span class="group-hover:translate-x-1 transition-transform">app</span> <span class="text-2xs font-mono text-muted/70 bg-bg dark:bg-bg-dark px-1.5 py-0.5 rounded border border-border-subtle">Fullstack</span>
        </a>
        <a href="/docs/workloads/site" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between group">
          <span class="group-hover:translate-x-1 transition-transform">site</span> <span class="text-2xs font-mono text-muted/70 bg-bg dark:bg-bg-dark px-1.5 py-0.5 rounded border border-border-subtle">SSG</span>
        </a>
        <a href="/docs/workloads/book" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between group">
          <span class="group-hover:translate-x-1 transition-transform">book</span> <span class="text-2xs font-mono text-muted/70 bg-bg dark:bg-bg-dark px-1.5 py-0.5 rounded border border-border-subtle">Publishing</span>
        </a>
        <a href="/docs/workloads/worker" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between group">
          <span class="group-hover:translate-x-1 transition-transform">worker</span> <span class="text-2xs font-mono text-muted/70 bg-bg dark:bg-bg-dark px-1.5 py-0.5 rounded border border-border-subtle">Async</span>
        </a>
        <a href="/docs/workloads/service" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between group">
          <span class="group-hover:translate-x-1 transition-transform">service</span> <span class="text-2xs font-mono text-muted/70 bg-bg dark:bg-bg-dark px-1.5 py-0.5 rounded border border-border-subtle">Microservice</span>
        </a>
        <a href="/docs/workloads/gateway" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between group">
          <span class="group-hover:translate-x-1 transition-transform">gateway</span> <span class="text-2xs font-mono text-muted/70 bg-bg dark:bg-bg-dark px-1.5 py-0.5 rounded border border-border-subtle">Proxy</span>
        </a>
        <a href="/docs/workloads/cli" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between group">
          <span class="group-hover:translate-x-1 transition-transform">cli</span> <span class="text-2xs font-mono text-muted/70 bg-bg dark:bg-bg-dark px-1.5 py-0.5 rounded border border-border-subtle">Terminal</span>
        </a>
        <a href="/docs/workloads/infra" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between group">
          <span class="group-hover:translate-x-1 transition-transform">infra</span> <span class="text-2xs font-mono text-muted/70 bg-bg dark:bg-bg-dark px-1.5 py-0.5 rounded border border-border-subtle">Cloud IaC</span>
        </a>
      </div>

      <!-- Col 2: Documentation -->
      <div class="flex flex-col gap-3">
        <div class="flex items-center gap-2 mb-1">
          <span class="text-xs font-mono font-bold text-secondary">02.</span>
          <strong class="text-xs font-mono font-bold uppercase tracking-wider text-fg dark:text-fg-dark" data-i18n="footer.docs_title">Documentation</strong>
        </div>
        <a href="/docs/overview" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors hover:translate-x-1 transition-transform inline-block">Overview</a>
        <a href="/docs/getting-started" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors hover:translate-x-1 transition-transform inline-block">Getting Started</a>
        <a href="/docs/getting-started/dsl" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors hover:translate-x-1 transition-transform inline-block">Component DSL (.kiw)</a>
        <a href="/docs/workloads" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors hover:translate-x-1 transition-transform inline-block">Workloads Guide</a>
        <a href="/docs/cli-reference" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors hover:translate-x-1 transition-transform inline-block">CLI Reference</a>
        <a href="/docs/core-libraries/model" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors hover:translate-x-1 transition-transform inline-block">Core Libraries (pkg/*)</a>
        <a href="/docs/ui" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors hover:translate-x-1 transition-transform inline-block">UI Components</a>
        <a href="/mcp" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors hover:translate-x-1 transition-transform inline-block">MCP Protocol</a>
      </div>

      <!-- Col 3: Ecosystem Platforms -->
      <div class="flex flex-col gap-3">
        <div class="flex items-center gap-2 mb-1">
          <span class="text-xs font-mono font-bold text-accent">03.</span>
          <strong class="text-xs font-mono font-bold uppercase tracking-wider text-fg dark:text-fg-dark" data-i18n="footer.ecosystem_title">Ecosystem Platforms</strong>
        </div>
        <a href="/docs/security-platforms/virtual-workspace" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between group">
          <span class="group-hover:translate-x-1 transition-transform">Dash Workspace</span> <Badge Variant="primary" Size="sm" Class="font-mono text-2xs">AI</Badge>
        </a>
        <a href="/docs/security-platforms/cloud-paas" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between group">
          <span class="group-hover:translate-x-1 transition-transform">Cloud PaaS</span> <Badge Variant="primary" Size="sm" Class="font-mono text-2xs">PaaS</Badge>
        </a>
        <a href="/docs/security-platforms/identity-and-auth" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between group">
          <span class="group-hover:translate-x-1 transition-transform">Auth Platform</span> <Badge Variant="primary" Size="sm" Class="font-mono text-2xs">SSO</Badge>
        </a>
        <a href="https://github.com/krewire/krew" target="_blank" rel="noopener" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between group">
          <span class="group-hover:translate-x-1 transition-transform">krew CLI Toolchain</span> <Badge Variant="secondary" Size="sm" Class="font-mono text-2xs">Tool</Badge>
        </a>
        <a href="https://github.com/krewire/ui" target="_blank" rel="noopener" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between group">
          <span class="group-hover:translate-x-1 transition-transform">UI Catalog (.kiw)</span> <Badge Variant="neutral" Size="sm" Class="font-mono text-2xs">Design</Badge>
        </a>
        <a href="https://github.com/krewire/tui" target="_blank" rel="noopener" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between group">
          <span class="group-hover:translate-x-1 transition-transform">Pure-Go TUI</span> <Badge Variant="neutral" Size="sm" Class="font-mono text-2xs">Terminal</Badge>
        </a>
        <a href="https://github.com/krewire/krewire" target="_blank" rel="noopener" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between group">
          <span class="group-hover:translate-x-1 transition-transform">Core Monorepo</span> <Badge Variant="neutral" Size="sm" Class="font-mono text-2xs">MIT</Badge>
        </a>
      </div>

      <!-- Col 4: Architecture & Guides -->
      <div class="flex flex-col gap-3">
        <div class="flex items-center gap-2 mb-1">
          <span class="text-xs font-mono font-bold text-primary">04.</span>
          <strong class="text-xs font-mono font-bold uppercase tracking-wider text-fg dark:text-fg-dark" data-i18n="footer.guides_title">Architecture &amp; Guides</strong>
        </div>
        <a href="/docs/architecture/layered-pyramid" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors hover:translate-x-1 transition-transform inline-block">6-Layer Pyramid</a>
        <a href="/docs/architecture/ecosystem-dag" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors hover:translate-x-1 transition-transform inline-block">Ecosystem Battery DAG</a>
        <a href="/docs/architecture/scope-levels" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors hover:translate-x-1 transition-transform inline-block">Scope Levels (5 Levels)</a>
        <a href="/docs/guides/open-core-and-licensing" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors hover:translate-x-1 transition-transform inline-block">Open Core &amp; License Model</a>
        <a href="/docs/guides/deployment-and-operations" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors hover:translate-x-1 transition-transform inline-block">Deployment &amp; Cloud Ops</a>
        <a href="/docs/guides/agentic-development" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors hover:translate-x-1 transition-transform inline-block">Agentic SDLC Engine</a>
        <a href="/ui/playground" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors hover:translate-x-1 transition-transform inline-block">Interactive UI Playground</a>
      </div>

    </div>

    <!-- Bottom Bar: Credit, Status & Quick Links -->
    <div class="pt-6 sm:pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs font-semibold text-muted dark:text-muted-dark">
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-2 text-center md:text-left">
        <span data-i18n-html="footer.copyright_html">© 2026 Krewire Team — Built with Krewire &amp; .kiw DSL.</span>
        <span class="hidden sm:inline opacity-40">·</span>
        <span class="text-2xs font-mono text-muted/80">Permanent MIT Open Core</span>
      </div>
      <div class="flex items-center gap-4 font-mono text-xs">
        <a href="https://github.com/krewire/krewire/releases" target="_blank" rel="noopener" class="hover:text-primary transition-colors flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>v0.2.3</span>
        </a>
        <span>·</span>
        <a href="https://github.com/krewire" target="_blank" rel="noopener" class="hover:text-primary transition-colors">GitHub</a>
        <span>·</span>
        <a href="/docs/guides/open-core-and-licensing" class="hover:text-primary transition-colors">License</a>
        <span>·</span>
        <a href="#top" class="hover:text-primary transition-colors flex items-center gap-1" onclick="window.scrollTo({top:0,behavior:'smooth'}); return false;">
          <span>↑ Top</span>
        </a>
      </div>
    </div>
  </div>
</footer>
