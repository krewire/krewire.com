<footer class="bg-bg-2 dark:bg-bg-dark-2 w-full footer-site {class}" style="border-top:var(--pop-border)" data-kiw-component="Footer">
  <div class="container-site pt-10 pb-8 sm:pt-12 sm:pb-10 lg:pt-14 lg:pb-12">
    <!-- Top 5-column Grid (12 cols total on lg: 4 + 2 + 2 + 2 + 2) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-12 gap-8 lg:gap-8 pb-8 sm:pb-10" style="border-bottom:var(--pop-border-thin)">
      
      <!-- Col 1: Brand & Social Media (4 cols on lg) -->
      <div class="sm:col-span-2 md:col-span-4 lg:col-span-4 flex flex-col items-start pr-0 lg:pr-8">
        <div class="flex items-center gap-2.5 font-black text-xl mb-3">
          <span class="icon-box bg-primary text-primary-content w-8 h-8 text-base flex items-center justify-center font-bold">◈</span>
          <span class="tracking-tight text-fg dark:text-fg-dark">Krewire</span>
          <Badge Variant="secondary" Size="sm" Class="ml-1 font-mono">{#if version}{version}{:else}v0.2.3{/if}</Badge>
        </div>
        <p class="text-xs sm:text-sm text-muted dark:text-muted-dark leading-relaxed mb-4 max-w-sm" data-i18n-html="footer.tagline_html">
          The Complete Go SDLC Platform.<br>
          <span class="text-fg dark:text-fg-dark font-bold">One Ecosystem. Every Workload.</span>
        </p>

        <!-- Value Proposition Badges -->
        <div class="flex flex-wrap gap-2 mb-5">
          <Badge Variant="neutral" Size="sm" Class="font-mono text-2xs">100% Pure Go</Badge>
          <Badge Variant="neutral" Size="sm" Class="font-mono text-2xs">Zero npm / Node</Badge>
          <Badge Variant="neutral" Size="sm" Class="font-mono text-2xs">MIT Open Core</Badge>
        </div>

        <!-- Social Media Channels with Icons -->
        <div class="flex flex-col gap-2.5 w-full">
          <span class="text-2xs font-mono font-bold uppercase tracking-wider text-muted dark:text-muted-dark">Connect &amp; Social</span>
          <div class="flex items-center gap-2.5">
            <!-- Email -->
            <a href="mailto:hello@krewire.com" class="social-icon-btn flex items-center justify-center w-9 h-9 rounded-xl border-2 border-border bg-bg dark:bg-bg-dark text-fg dark:text-fg-dark hover:bg-primary hover:text-primary-content transition-all shadow-[2px_2px_0px_var(--border)] hover:-translate-y-0.5" title="Email: hello@krewire.com" aria-label="Email hello@krewire.com">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </a>
            <!-- GitHub -->
            <a href="https://github.com/krewire" target="_blank" rel="noopener" class="social-icon-btn flex items-center justify-center w-9 h-9 rounded-xl border-2 border-border bg-bg dark:bg-bg-dark text-fg dark:text-fg-dark hover:bg-primary hover:text-primary-content transition-all shadow-[2px_2px_0px_var(--border)] hover:-translate-y-0.5" title="GitHub: @krewire" aria-label="GitHub Profile">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
            </a>
            <!-- Instagram -->
            <a href="https://instagram.com/krewire" target="_blank" rel="noopener" class="social-icon-btn flex items-center justify-center w-9 h-9 rounded-xl border-2 border-border bg-bg dark:bg-bg-dark text-fg dark:text-fg-dark hover:bg-primary hover:text-primary-content transition-all shadow-[2px_2px_0px_var(--border)] hover:-translate-y-0.5" title="Instagram: @krewire" aria-label="Instagram Profile">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
            </a>
          </div>
          <div class="flex flex-col gap-1 text-xs font-semibold text-muted dark:text-muted-dark mt-1">
            <a href="mailto:hello@krewire.com" class="hover:text-primary transition-colors flex items-center gap-1.5">
              <span>✉</span> <span>hello@krewire.com</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Col 2: 8 Workloads (2 cols on lg) -->
      <div class="lg:col-span-2 flex flex-col gap-2.5">
        <strong class="text-2xs font-mono font-bold uppercase tracking-wider text-fg dark:text-fg-dark mb-1" data-i18n="footer.workloads_title">8 Workloads</strong>
        <a href="/docs/workloads/app" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between">
          <span>app</span> <span class="text-2xs font-mono text-muted/70">Fullstack</span>
        </a>
        <a href="/docs/workloads/site" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between">
          <span>site</span> <span class="text-2xs font-mono text-muted/70">SSG</span>
        </a>
        <a href="/docs/workloads/book" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between">
          <span>book</span> <span class="text-2xs font-mono text-muted/70">Publishing</span>
        </a>
        <a href="/docs/workloads/worker" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between">
          <span>worker</span> <span class="text-2xs font-mono text-muted/70">Async</span>
        </a>
        <a href="/docs/workloads/service" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between">
          <span>service</span> <span class="text-2xs font-mono text-muted/70">Microservice</span>
        </a>
        <a href="/docs/workloads/gateway" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between">
          <span>gateway</span> <span class="text-2xs font-mono text-muted/70">Proxy</span>
        </a>
        <a href="/docs/workloads/cli" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between">
          <span>cli</span> <span class="text-2xs font-mono text-muted/70">Terminal</span>
        </a>
        <a href="/docs/workloads/infra" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between">
          <span>infra</span> <span class="text-2xs font-mono text-muted/70">Cloud IaC</span>
        </a>
      </div>

      <!-- Col 3: Documentation (2 cols on lg) -->
      <div class="lg:col-span-2 flex flex-col gap-2.5">
        <strong class="text-2xs font-mono font-bold uppercase tracking-wider text-fg dark:text-fg-dark mb-1" data-i18n="footer.docs_title">Documentation</strong>
        <a href="/docs/overview" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">Overview</a>
        <a href="/docs/getting-started" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">Getting Started</a>
        <a href="/docs/getting-started/dsl" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">Component DSL</a>
        <a href="/docs/workloads" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">Workloads</a>
        <a href="/docs/cli-reference" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">CLI Reference</a>
        <a href="/docs/core-libraries/model" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">Core Libraries</a>
        <a href="/docs/ui" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">UI Components</a>
        <a href="/mcp" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">MCP Protocol</a>
      </div>

      <!-- Col 4: Ecosystem Platforms (2 cols on lg) -->
      <div class="lg:col-span-2 flex flex-col gap-2.5">
        <strong class="text-2xs font-mono font-bold uppercase tracking-wider text-fg dark:text-fg-dark mb-1" data-i18n="footer.ecosystem_title">Ecosystem Platforms</strong>
        <a href="/docs/security-platforms/virtual-workspace" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between">
          <span>Dash</span> <Badge Variant="primary" Size="sm" Class="font-mono text-2xs">AI</Badge>
        </a>
        <a href="/docs/security-platforms/cloud-paas" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between">
          <span>Cloud</span> <Badge Variant="primary" Size="sm" Class="font-mono text-2xs">PaaS</Badge>
        </a>
        <a href="/docs/security-platforms/identity-and-auth" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between">
          <span>Auth</span> <Badge Variant="primary" Size="sm" Class="font-mono text-2xs">SSO</Badge>
        </a>
        <a href="https://github.com/krewire/krew" target="_blank" rel="noopener" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between">
          <span>krew CLI</span> <Badge Variant="secondary" Size="sm" Class="font-mono text-2xs">Tool</Badge>
        </a>
        <a href="https://github.com/krewire/ui" target="_blank" rel="noopener" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between">
          <span>UI Catalog</span> <Badge Variant="neutral" Size="sm" Class="font-mono text-2xs">.kiw</Badge>
        </a>
        <a href="https://github.com/krewire/tui" target="_blank" rel="noopener" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between">
          <span>Pure-Go TUI</span> <Badge Variant="neutral" Size="sm" Class="font-mono text-2xs">Term</Badge>
        </a>
        <a href="https://github.com/krewire/krewire" target="_blank" rel="noopener" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors flex items-center justify-between">
          <span>Core Monorepo</span> <Badge Variant="neutral" Size="sm" Class="font-mono text-2xs">MIT</Badge>
        </a>
      </div>

      <!-- Col 5: Architecture & Guides (2 cols on lg) -->
      <div class="lg:col-span-2 flex flex-col gap-2.5">
        <strong class="text-2xs font-mono font-bold uppercase tracking-wider text-fg dark:text-fg-dark mb-1" data-i18n="footer.guides_title">Architecture &amp; Guides</strong>
        <a href="/docs/architecture/layered-pyramid" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">6-Layer Pyramid</a>
        <a href="/docs/architecture/ecosystem-dag" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">Ecosystem DAG</a>
        <a href="/docs/architecture/scope-levels" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">Scope Levels</a>
        <a href="/docs/guides/open-core-and-licensing" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">Open Core &amp; License</a>
        <a href="/docs/guides/deployment-and-operations" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">Deployment &amp; Ops</a>
        <a href="/docs/guides/agentic-development" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">Agentic SDLC</a>
        <a href="/ui/playground" class="text-xs sm:text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">UI Playground</a>
      </div>

    </div>

    <!-- Bottom Bar: Credit, Status & Quick Links -->
    <div class="pt-6 sm:pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs font-semibold text-muted dark:text-muted-dark">
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-2 text-center md:text-left">
        <span data-i18n-html="footer.copyright_html">© 2026 Krewire Team — Built with Krewire &amp; .kiw DSL.</span>
        <span class="hidden sm:inline opacity-40">·</span>
        <span class="text-2xs font-mono text-muted/80">Permanent MIT Open Core</span>
      </div>
      <div class="flex items-center gap-4 font-mono text-xs">
        <a href="https://github.com/krewire/krewire/releases" target="_blank" rel="noopener" class="hover:text-primary transition-colors flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>v0.2.3</span>
        </a>
        <span>·</span>
        <a href="https://github.com/krewire" target="_blank" rel="noopener" class="hover:text-primary transition-colors">GitHub</a>
        <span>·</span>
        <a href="/docs/guides/open-core-and-licensing" class="hover:text-primary transition-colors">License</a>
        <span>·</span>
        <a href="#top" class="hover:text-primary transition-colors flex items-center gap-1" onclick="window.scrollTo({top:0,behavior:'smooth'}); return false;">
          <span>↑ Top</span>
        </a>
      </div>
    </div>
  </div>
</footer>
