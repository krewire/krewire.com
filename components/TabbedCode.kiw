<div class="code-tabs-wrapper" data-code-tabs>
  <div class="code-tabs-nav" role="tablist">
    <button class="code-tab-btn active" onclick="switchCodeTab(this, 0)" role="tab" aria-selected="true">{tab1Title || "kiw run"}</button>
    <button class="code-tab-btn" onclick="switchCodeTab(this, 1)" role="tab" aria-selected="false">{tab2Title || "go run"}</button>
  </div>
  <div class="code-tabs-panels">
    <div class="code-tab-panel active" role="tabpanel">{tab1Content || ""}</div>
    <div class="code-tab-panel" role="tabpanel" style="display:none">{tab2Content || ""}</div>
  </div>
</div>

<style>
.code-tabs-wrapper {
  margin: 1.5rem 0;
  border: 1px solid var(--border-subtle, rgba(255,255,255,0.15));
  border-radius: 8px;
  overflow: hidden;
  background: var(--bg-2, #112646);
}
.code-tabs-nav {
  display: flex;
  background: rgba(0, 0, 0, 0.2);
  border-bottom: 1px solid var(--border-subtle, rgba(255,255,255,0.1));
}
.code-tab-btn {
  padding: 0.6rem 1.2rem;
  background: transparent;
  border: none;
  color: var(--muted, #9ab0ce);
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
  border-bottom: 2px solid transparent;
  transition: all 0.15s ease;
}
.code-tab-btn:hover {
  color: var(--fg, #FAF8F4);
}
.code-tab-btn.active {
  color: var(--primary, #39D353);
  border-bottom-color: var(--primary, #39D353);
}
.code-tab-panel {
  padding: 1rem;
}
</style>

<script>
function switchCodeTab(btn, index) {
  const wrapper = btn.closest('[data-code-tabs]');
  if (!wrapper) return;
  const buttons = wrapper.querySelectorAll('.code-tab-btn');
  const panels = wrapper.querySelectorAll('.code-tab-panel');
  buttons.forEach((b, i) => {
    b.classList.toggle('active', i === index);
    b.setAttribute('aria-selected', i === index ? 'true' : 'false');
  });
  panels.forEach((p, i) => {
    p.style.display = i === index ? 'block' : 'none';
    p.classList.toggle('active', i === index);
  });
}
</script>
