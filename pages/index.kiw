<!-- =====================================================================
     THREE PILLARS
     ===================================================================== -->
<section id="pillars" class="w-full bg-bg-2 dark:bg-bg-dark-2 bg-dots py-28 sm:py-36 md:py-40 lg:py-44 border-b-2 border-border">
  <div class="container-site">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">

      <!-- Left: Sticky Philosophy Column (4 cols) -->
      <div class="lg:col-span-4 lg:sticky lg:top-28">
        <Badge Variant="primary" Class="mb-3 sm:mb-4"><span data-i18n="pillars.badge">Three Pillars</span></Badge>
        <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-fg dark:text-fg-dark mb-4 sm:mb-5" data-i18n="pillars.title">Secure. Sustainable. Scalable.</h2>
        <p class="text-sm sm:text-base text-muted dark:text-muted-dark leading-relaxed mb-6 sm:mb-8" data-i18n="pillars.lead">
          Krewire is an end-to-end digital SDLC ecosystem — from the first line of the specification to running production. Every capability must pass all three pillars before it ships, and each claim traces to a spec, a test, or a gate.
        </p>
        <div class="card p-5 sm:p-6 bg-bg dark:bg-bg-dark mb-6">
          <p class="text-xs sm:text-sm italic text-muted dark:text-muted-dark leading-relaxed m-0">
            "Safety by default, near-zero cost is engineered, and growth is additive rather than a rewrite."
          </p>
          <div class="mt-3 text-xs font-mono font-bold text-fg dark:text-fg-dark">— ADR-3S001 Engineering Filter</div>
        </div>
      </div>

      <!-- Right: Stack of 3 Horizontal Architecture Feature Blocks (8 cols) -->
      <div class="lg:col-span-8 flex flex-col gap-6 sm:gap-8">

        <!-- Pillar 1: Secure -->
        <div class="card p-7 sm:p-8 md:p-9 bg-bg dark:bg-bg-dark hover:-translate-y-1 transition-all duration-200">
          <div class="flex items-center justify-between gap-3 mb-4">
            <div class="flex items-center gap-3.5">
              <span class="w-1.5 h-8 rounded-full shrink-0" style="background:#39D353"></span>
              <span class="icon-box bg-primary text-primary-content text-xl w-10 h-10 flex items-center justify-center font-bold">🛡</span>
              <h3 class="text-xl sm:text-2xl font-black tracking-tight text-fg dark:text-fg-dark" data-i18n="pillars.secure_title">Secure</h3>
            </div>
            <Badge Variant="primary" Size="sm"><span data-i18n="pillars.pillar1_badge">Pillar 01</span></Badge>
          </div>
          <p class="text-sm sm:text-base text-muted dark:text-muted-dark leading-relaxed mb-6" data-i18n="pillars.secure_desc">
            Security is a default, not a feature. A stdlib-first dependency graph, secure-by-default HTTP primitives, OWASP/CWE-aligned controls, secrets referenced — never stored — and WASM sandboxing keep the attack surface small and auditable.
          </p>
          <div class="flex flex-wrap gap-2.5 sm:gap-3">
            <Badge Variant="neutral" Size="sm">0 CGO</Badge>
            <Badge Variant="neutral" Size="sm">SafePath Traversal Guards</Badge>
            <Badge Variant="neutral" Size="sm">Auto-Escaped HTML</Badge>
            <Badge Variant="neutral" Size="sm">Zero Committed Secrets</Badge>
          </div>
        </div>

        <!-- Pillar 2: Sustainable -->
        <div class="card p-7 sm:p-8 md:p-9 bg-bg dark:bg-bg-dark hover:-translate-y-1 transition-all duration-200">
          <div class="flex items-center justify-between gap-3 mb-4">
            <div class="flex items-center gap-3.5">
              <span class="w-1.5 h-8 rounded-full shrink-0" style="background:#00D1C1"></span>
              <span class="icon-box bg-primary text-primary-content text-xl w-10 h-10 flex items-center justify-center font-bold">🌱</span>
              <h3 class="text-xl sm:text-2xl font-black tracking-tight text-fg dark:text-fg-dark" data-i18n="pillars.sustainable_title">Sustainable</h3>
            </div>
            <Badge Variant="primary" Size="sm"><span data-i18n="pillars.pillar2_badge">Pillar 02</span></Badge>
          </div>
          <p class="text-sm sm:text-base text-muted dark:text-muted-dark leading-relaxed mb-6" data-i18n="pillars.sustainable_desc">
            Software a single builder can still read, run, and afford a decade from now. Single static binaries with embedded assets, opt-in batteries that cost nothing when unused, boring proven parts, and no license fees — ever.
          </p>
          <div class="flex flex-wrap gap-2.5 sm:gap-3">
            <Badge Variant="neutral" Size="sm">10–30 MB Lean RAM</Badge>
            <Badge Variant="neutral" Size="sm">Single Static Binary</Badge>
            <Badge Variant="neutral" Size="sm">Zero npm / Zero Bundlers</Badge>
            <Badge Variant="neutral" Size="sm">Permanent MIT Open Core</Badge>
          </div>
        </div>

        <!-- Pillar 3: Scalable -->
        <div class="card p-7 sm:p-8 md:p-9 bg-bg dark:bg-bg-dark hover:-translate-y-1 transition-all duration-200">
          <div class="flex items-center justify-between gap-3 mb-4">
            <div class="flex items-center gap-3.5">
              <span class="w-1.5 h-8 rounded-full shrink-0" style="background:#ffbd2e"></span>
              <span class="icon-box bg-primary text-primary-content text-xl w-10 h-10 flex items-center justify-center font-bold">⚡</span>
              <h3 class="text-xl sm:text-2xl font-black tracking-tight text-fg dark:text-fg-dark" data-i18n="pillars.scalable_title">Scalable</h3>
            </div>
            <Badge Variant="primary" Size="sm"><span data-i18n="pillars.pillar3_badge">Pillar 03</span></Badge>
          </div>
          <p class="text-sm sm:text-base text-muted dark:text-muted-dark leading-relaxed mb-6" data-i18n="pillars.scalable_desc">
            Growth is additive, not a rewrite. The progressive pipeline takes a product from static site to monolith to workers, services, and infra — each stage an opt-in, reversible battery, from a $5 VPS to hyperscale.
          </p>
          <div class="flex flex-wrap gap-2.5 sm:gap-3">
            <Badge Variant="neutral" Size="sm">7-Stage Pipeline (P0-P6)</Badge>
            <Badge Variant="neutral" Size="sm">Reversible Provider Swaps</Badge>
            <Badge Variant="neutral" Size="sm">Zero Lateral Peer Coupling</Badge>
            <Badge Variant="neutral" Size="sm">$5 VPS to Hyperscale</Badge>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

