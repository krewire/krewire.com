     HERO
     ===================================================================== -->
<section class="w-full bg-bg dark:bg-bg-dark bg-dots py-24 sm:py-28 md:py-32 lg:py-36 border-b-2 border-border">
  <div class="container-site">
    <div class="flex flex-col md:grid md:grid-cols-2 md:items-center gap-8 sm:gap-10 md:gap-12 lg:gap-16">

      <!-- Copy -->
      <div class="min-w-0 w-full">
        <div class="flex flex-col items-start w-full">
          <!-- Eyebrow -->
          <div class="mb-4 sm:mb-6">
            <Badge Variant="primary" dot=true>
              <span data-i18n="hero.eyebrow">GO-FIRST SOFTWARE ENGINEERING ECOSYSTEM · {#if version}{version}{:else}v0.2.3{/if}</span>
            </Badge>
          </div>

          <!-- Headline -->
          <h1 class="font-black tracking-tighter leading-tight text-fg dark:text-fg-dark break-words mb-5 sm:mb-6"
              style="font-size:clamp(30px,6.5vw,56px); letter-spacing:-0.04em"
              data-i18n-html="hero.title_html">
            The Go-First Software Engineering Ecosystem.<br class="hidden sm:inline">
            <span class="text-primary">One Ecosystem. Every Workload.</span>
          </h1>

          <!-- Lead -->
          <p class="text-sm sm:text-base md:text-lg text-muted dark:text-muted-dark leading-relaxed max-w-xl lg:max-w-2xl xl:max-w-none mb-6 sm:mb-8"
             data-i18n-html="hero.lead_html">
            Krewire is an end-to-end <b class="text-fg dark:text-fg-dark">digital SDLC platform and application ecosystem</b> in Go — spanning the entire software lifecycle from specification, autonomous AI agents, enterprise SSO &amp; RBAC, hybrid PaaS, virtual dev workspaces, to production server operations. Far beyond modular Go libraries, Krewire delivers a cohesive, unified platform driven by a single CLI <code class="code-inline">kiw</code>. Built on three immutable pillars: <b class="text-fg dark:text-fg-dark">secure</b>, <b class="text-fg dark:text-fg-dark">sustainable</b>, and <b class="text-fg dark:text-fg-dark">scalable</b>.
          </p>

          <!-- Quick terminal: install first -->
          <div class="w-full max-w-xl lg:max-w-2xl xl:max-w-none flex flex-col gap-3.5 mb-8 sm:mb-10">
            <Terminal Command="curl -fsSL https://krewire.com/scripts/install.sh | sh" Class="w-full" />
            <Terminal Command="kiw new my-app --site && cd my-app && kiw dev" PromptColor="muted" Class="w-full" />
          </div>

          <!-- CTAs: stacked on mobile, row on sm+ -->
          <div class="w-full sm:w-auto flex flex-wrap items-center gap-4 sm:gap-5 mb-5 sm:mb-6">
            <Button Variant="primary" Size="lg" Href="/docs/getting-started"><span data-i18n="hero.cta_start">Get Started — 5 Min →</span></Button>
            <Button Variant="outline" Size="lg" Href="https://open.krewire.com/"><span data-i18n="hero.cta_contribute">Contribute →</span></Button>
          </div>

          <p class="text-xs font-semibold text-muted dark:text-muted-dark mt-1" data-i18n="hero.meta">Go 1.27.1+ · Spec to Production · File-based routing · Scoped CSS · Progressive by design</p>
        </div>
      </div>

      <!-- Art / Code window -->
      <div class="min-w-0 w-full mt-6 md:mt-0">
        <CodeWindow title="main.go">
<span class="c">// One Ecosystem. Every Workload.</span>
<span class="k">package</span> main

<span class="k">import</span> (
    <span class="s">"github.com/krewire/krewire/pkg/web"</span>
    <span class="s">"github.com/krewire/krewire/pkg/model"</span>
)

<span class="k">func</span> <span class="f">main</span>() {
    app := web.New()

    <span class="c">// End-to-end SDLC platform in pure Go</span>
    app.Get(<span class="s">"/"</span>, <span class="k">func</span>(c *web.Context) error {
        <span class="k">return</span> c.JSON(<span class="n">200</span>, web.Map{
            <span class="s">"ecosystem"</span>:  <span class="s">"Krewire"</span>,
            <span class="s">"workload"</span>:   model.KindApp,
            <span class="s">"pillars"</span>:    []string{<span class="s">"secure"</span>, <span class="s">"sustainable"</span>, <span class="s">"scalable"</span>},
            <span class="s">"platforms"</span>:  []string{<span class="s">"krew"</span>, <span class="s">"auth"</span>, <span class="s">"cloud"</span>, <span class="s">"dash"</span>, <span class="s">"panel"</span>},
            <span class="s">"footprint"</span>:  <span class="s">"10-30 MB RAM"</span>,
            <span class="s">"cold_start"</span>: <span class="s">"&lt; 1ms"</span>,
        })
    })

    app.Run(<span class="s">":8080"</span>)
}
        </CodeWindow>
      </div>
    </div>
  </div>
</section>

