<section class="w-full bg-bg dark:bg-bg-dark py-10 sm:py-12 md:py-14 lg:py-16" style="border-bottom:var(--pop-border)">
  <div class="container-site">
    <div class="section-head">
      <span class="badge badge-primary mb-3" data-i18n="matrix.badge">Stack Comparison</span>
      <h2 data-i18n="matrix.title">Why Engineers Choose Krewire</h2>
      <p data-i18n="matrix.lead">Compare the simplicity of an all-in-one Go toolchain against fragmented multi-language setups.</p>
    </div>

    <div class="w-full overflow-x-auto rounded-xl min-w-0" style="border:var(--pop-border); box-shadow:var(--pop-shadow-lg); background:var(--bg)">
      <table class="w-full text-left border-collapse text-xs sm:text-sm">
        <thead>
          <tr style="border-bottom:var(--pop-border); background:var(--bg-2)">
            <th class="py-2.5 sm:py-3.5 px-3 sm:px-4 font-black text-2xs sm:text-xs uppercase tracking-wider text-fg dark:text-fg-dark">Architecture Dimension</th>
            <th class="py-2.5 sm:py-3.5 px-3 sm:px-4 font-black text-2xs sm:text-xs uppercase tracking-wider text-muted dark:text-muted-dark">Traditional Fragmented Stack</th>
            <th class="py-2.5 sm:py-3.5 px-3 sm:px-4 font-black text-2xs sm:text-xs uppercase tracking-wider text-primary">Krewire Unified Go</th>
          </tr>
        </thead>
        <tbody class="divide-y" style="border-color:var(--border-subtle)">
          <tr>
            <td class="py-2.5 sm:py-3.5 px-3 sm:px-4 font-bold text-fg dark:text-fg-dark">Toolchain & Runtime</td>
            <td class="py-2.5 sm:py-3.5 px-3 sm:px-4 text-muted dark:text-muted-dark">2–3 Languages (Go + Node.js/TS + Python/HCL)</td>
            <td class="py-2.5 sm:py-3.5 px-3 sm:px-4 font-bold text-primary">100% Pure Go across all workloads</td>
          </tr>
          <tr>
            <td class="py-2.5 sm:py-3.5 px-3 sm:px-4 font-bold text-fg dark:text-fg-dark">Package Management</td>
            <td class="py-2.5 sm:py-3.5 px-3 sm:px-4 text-muted dark:text-muted-dark"><code class="code-inline">go.mod</code> + <code class="code-inline">package.json</code> + npm/pnpm trees</td>
            <td class="py-2.5 sm:py-3.5 px-3 sm:px-4 font-bold text-primary">Single <code class="code-inline">go.mod</code> (Zero npm / Zero JS)</td>
          </tr>
          <tr>
            <td class="py-2.5 sm:py-3.5 px-3 sm:px-4 font-bold text-fg dark:text-fg-dark">Developer CLI</td>
            <td class="py-2.5 sm:py-3.5 px-3 sm:px-4 text-muted dark:text-muted-dark">Multiple: Air + npm + Cobra + Terraform</td>
            <td class="py-2.5 sm:py-3.5 px-3 sm:px-4 font-bold text-primary">One binary CLI: <code class="code-inline">kiw</code></td>
          </tr>
          <tr>
            <td class="py-2.5 sm:py-3.5 px-3 sm:px-4 font-bold text-fg dark:text-fg-dark">Configuration</td>
            <td class="py-2.5 sm:py-3.5 px-3 sm:px-4 text-muted dark:text-muted-dark">Scattered (.air.toml, vite.config, tsconfig, Dockerfile)</td>
            <td class="py-2.5 sm:py-3.5 px-3 sm:px-4 font-bold text-primary">Single unified <code class="code-inline">krewire.yaml</code></td>
          </tr>
          <tr>
            <td class="py-2.5 sm:py-3.5 px-3 sm:px-4 font-bold text-fg dark:text-fg-dark">Component Styling</td>
            <td class="py-2.5 sm:py-3.5 px-3 sm:px-4 text-muted dark:text-muted-dark">Tailwind CLI / PostCSS bundler pipeline</td>
            <td class="py-2.5 sm:py-3.5 px-3 sm:px-4 font-bold text-primary">Native scoped <code class="code-inline">.kiw</code> components</td>
          </tr>
          <tr>
            <td class="py-2.5 sm:py-3.5 px-3 sm:px-4 font-bold text-fg dark:text-fg-dark">Production Deployment</td>
            <td class="py-2.5 sm:py-3.5 px-3 sm:px-4 text-muted dark:text-muted-dark">Heavy multi-stage Docker containers with Node layers</td>
            <td class="py-2.5 sm:py-3.5 px-3 sm:px-4 font-bold text-primary">Single self-contained Go binary or static assets</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

