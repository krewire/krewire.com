    <div class="w-full overflow-x-auto rounded-xl min-w-0" style="border:var(--pop-border); box-shadow:var(--pop-shadow-lg); background:var(--bg)">
      <table class="w-full text-left border-collapse text-xs sm:text-sm">
        <thead>
          <tr style="border-bottom:var(--pop-border); background:var(--bg-2)">
            <th class="py-3.5 sm:py-4 px-4 sm:px-6 font-black text-2xs sm:text-xs uppercase tracking-wider text-fg dark:text-fg-dark" data-i18n="matrix.th_dimension">Architecture Dimension</th>
            <th class="py-3.5 sm:py-4 px-4 sm:px-6 font-black text-2xs sm:text-xs uppercase tracking-wider text-muted dark:text-muted-dark" data-i18n="matrix.th_traditional">Traditional Fragmented Stack</th>
            <th class="py-3.5 sm:py-4 px-4 sm:px-6 font-black text-2xs sm:text-xs uppercase tracking-wider text-primary" data-i18n="matrix.th_krewire">Krewire Unified Go</th>
          </tr>
        </thead>
        <tbody class="divide-y" style="border-color:var(--border-subtle)">
          <tr class="hover:bg-primary/5 transition-colors">
            <td class="py-4 px-4 sm:px-6 font-bold text-fg dark:text-fg-dark" data-i18n="matrix.row1_dim">Toolchain &amp; Runtime</td>
            <td class="py-4 px-4 sm:px-6 text-muted dark:text-muted-dark" data-i18n="matrix.row1_trad">2–3 Languages (Go + Node.js/TS + Python/HCL)</td>
            <td class="py-4 px-4 sm:px-6 font-bold text-primary" data-i18n="matrix.row1_krewire">✓ 100% Pure Go across all workloads</td>
          </tr>
          <tr class="hover:bg-primary/5 transition-colors">
            <td class="py-4 px-4 sm:px-6 font-bold text-fg dark:text-fg-dark" data-i18n="matrix.row2_dim">Package Management</td>
            <td class="py-4 px-4 sm:px-6 text-muted dark:text-muted-dark" data-i18n="matrix.row2_trad">go.mod + package.json + npm/pnpm trees</td>
            <td class="py-4 px-4 sm:px-6 font-bold text-primary" data-i18n="matrix.row2_krewire">✓ Single go.mod (Zero npm / Zero JS)</td>
          </tr>
          <tr class="hover:bg-primary/5 transition-colors">
            <td class="py-4 px-4 sm:px-6 font-bold text-fg dark:text-fg-dark" data-i18n="matrix.row3_dim">Developer CLI</td>
            <td class="py-4 px-4 sm:px-6 text-muted dark:text-muted-dark" data-i18n="matrix.row3_trad">Multiple: Air + npm + Cobra + Terraform</td>
            <td class="py-4 px-4 sm:px-6 font-bold text-primary" data-i18n="matrix.row3_krewire">✓ One binary CLI: kiw</td>
          </tr>
          <tr class="hover:bg-primary/5 transition-colors">
            <td class="py-4 px-4 sm:px-6 font-bold text-fg dark:text-fg-dark" data-i18n="matrix.row4_dim">Configuration</td>
            <td class="py-4 px-4 sm:px-6 text-muted dark:text-muted-dark" data-i18n="matrix.row4_trad">Scattered (.air.toml, vite.config, tsconfig, Dockerfile)</td>
            <td class="py-4 px-4 sm:px-6 font-bold text-primary" data-i18n="matrix.row4_krewire">✓ Single unified krewire.yaml</td>
          </tr>
          <tr class="hover:bg-primary/5 transition-colors">
            <td class="py-4 px-4 sm:px-6 font-bold text-fg dark:text-fg-dark" data-i18n="matrix.row5_dim">Component Styling</td>
