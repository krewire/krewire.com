<!-- =====================================================================
     FOUR STEPS
     ===================================================================== -->
<section class="w-full bg-bg-2 dark:bg-bg-dark-2 bg-dots py-10 sm:py-12 md:py-14 lg:py-16" style="border-bottom:var(--pop-border)">
  <div class="container-site">
    <div class="section-head">
      <span class="badge badge-secondary mb-3" data-i18n="steps.badge">Developer Workflow</span>
      <h2 data-i18n="steps.title">From Zero to Production in 4 Steps</h2>
      <p data-i18n="steps.lead">Install once, then scaffold, develop, and deploy — no toolchain fatigue, no breaking dependency trees.</p>
    </div>

    <!-- Grid: 1 col on mobile → 2 col on sm/md → 4 col on lg -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-4 md:gap-5 lg:gap-5">

      <!-- Step 1: Install -->
      <div class="card">
        <div class="flex items-center justify-between gap-2 mb-3">
          <span class="icon-box bg-primary text-primary-content text-base font-black">1</span>
          <span class="badge badge-primary text-2xs font-mono">Install</span>
        </div>
        <h3 class="text-lg font-black tracking-tight mb-2 text-fg dark:text-fg-dark">kiw install</h3>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed mb-3" data-i18n="steps.s1_desc">One command installs the <code class="code-inline">kiw</code> CLI on Linux or macOS. No package manager needed.</p>
        <Terminal Command="curl -fsSL https://krewire.com/scripts/install.sh | sh" Class="mt-auto" />
      </div>

      <!-- Step 2: Scaffold -->
      <div class="card">
        <div class="flex items-center justify-between gap-2 mb-3">
          <span class="icon-box bg-primary text-primary-content text-base font-black">2</span>
          <span class="badge badge-secondary text-2xs font-mono">Scaffold</span>
        </div>
        <h3 class="text-lg font-black tracking-tight mb-2 text-fg dark:text-fg-dark">kiw new</h3>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed mb-3" data-i18n="steps.s2_desc">Generate a production-ready project template for any workload in under one second.</p>
        <Terminal Command="kiw new my-site --site && cd my-site" Class="mt-auto" />
      </div>

      <!-- Step 3: Develop -->
      <div class="card">
        <div class="flex items-center justify-between gap-2 mb-3">
          <span class="icon-box bg-primary text-primary-content text-base font-black">3</span>
          <span class="badge badge-secondary text-2xs font-mono">Develop</span>
        </div>
        <h3 class="text-lg font-black tracking-tight mb-2 text-fg dark:text-fg-dark">kiw dev</h3>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed mb-3" data-i18n="steps.s3_desc">Instant hot-reload local development server with file-based routing and scoped CSS updates.</p>
        <Terminal Command="kiw dev" Class="mt-auto" />
      </div>

      <!-- Step 4: Deploy -->
      <div class="card">
        <div class="flex items-center justify-between gap-2 mb-3">
          <span class="icon-box bg-primary text-primary-content text-base font-black">4</span>
          <span class="badge badge-secondary text-2xs font-mono">Deploy</span>
        </div>
        <h3 class="text-lg font-black tracking-tight mb-2 text-fg dark:text-fg-dark">kiw deploy</h3>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed mb-3" data-i18n="steps.s4_desc">Compile into a single static binary or static asset bundle and ship to GitHub Pages or Docker.</p>
        <Terminal Command="kiw deploy --target gh-pages" Class="mt-auto" />
      </div>

    </div>
  </div>
</section>


<!-- =====================================================================
     WHY KREWIRE
     ===================================================================== -->
<section class="w-full bg-bg dark:bg-bg-dark py-10 sm:py-12 md:py-14 lg:py-16" style="border-bottom:var(--pop-border)">
  <div class="container-site">
    <div class="section-head">
      <span class="badge badge-primary mb-3" data-i18n="why.badge">Architecture & Philosophy</span>
      <h2 data-i18n="why.title">Go-First. Progressive. Zero Bloat.</h2>
      <p data-i18n="why.lead">Built for engineers who value compilation speed, predictable deployments, and maintainable software architecture.</p>
    </div>

    <!-- Grid: 1 col on mobile → 2 col on sm/md → 4 col on lg -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-4 md:gap-5 lg:gap-5">

      <div class="card">
        <span class="icon-box bg-secondary text-secondary-content mb-4 text-xl">◈</span>
        <h3 class="text-base font-black tracking-tight mb-2 text-fg dark:text-fg-dark" data-i18n="why.w1_title">Pure Go Toolchain</h3>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed" data-i18n="why.w1_desc">No Node.js, no npm dependencies, and no bundler configuration. Your entire application compiles with standard Go tooling into clean, self-contained binaries.</p>
      </div>

      <div class="card">
        <span class="icon-box bg-secondary text-secondary-content mb-4 text-xl">◧</span>
        <h3 class="text-base font-black tracking-tight mb-2 text-fg dark:text-fg-dark" data-i18n="why.w2_title">Scoped .kiw Components</h3>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed" data-i18n="why.w2_desc">Combines YAML frontmatter, standard Go HTML templates, and scoped <code class="code-inline">&lt;style&gt;</code> blocks. CSS classes never leak outside their component boundary.</p>
      </div>

      <div class="card">
        <span class="icon-box bg-secondary text-secondary-content mb-4 text-xl">⚡</span>
        <h3 class="text-base font-black tracking-tight mb-2 text-fg dark:text-fg-dark" data-i18n="why.w3_title">Progressive Scaling</h3>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed" data-i18n="why.w3_desc">Start as a lightweight static site, grow into a fullstack web monolith, then seamlessly extract background workers and microservices — all within the same ecosystem.</p>
      </div>

      <div class="card">
        <span class="icon-box bg-secondary text-secondary-content mb-4 text-xl">🛡</span>
        <h3 class="text-base font-black tracking-tight mb-2 text-fg dark:text-fg-dark" data-i18n="why.w4_title">Enterprise Resilience</h3>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed" data-i18n="why.w4_desc">Engineered with production defaults: structured JSON logging, distributed tracing, health checks, circuit breakers, and graceful shutdown out of the box.</p>
      </div>

    </div>
  </div>
</section>

<!-- =====================================================================
     DSL SHOWCASE
     ===================================================================== -->
<section class="w-full bg-bg-2 dark:bg-bg-dark-2 bg-dots py-10 sm:py-12 md:py-14 lg:py-16" style="border-bottom:var(--pop-border)">
  <div class="container-site">
    <div class="section-head">
      <span class="badge badge-secondary mb-3" data-i18n="dsl.badge">Component DSL</span>
      <h2 data-i18n="dsl.title">Write Pages as Clean .kiw Components</h2>
      <p data-i18n="dsl.lead">The elegance of Svelte and Astro brought to Go. Frontmatter + HTML + scoped CSS in one intuitive file.</p>
    </div>

    <!-- Grid: 1 col on mobile/sm → 2 col on md/lg -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 lg:gap-10 items-start">

      <!-- Code panel -->
      <div class="w-full rounded-xl overflow-hidden min-w-0" style="background:#0B1F3B; border:var(--pop-border); box-shadow:var(--pop-shadow-lg)">
        <!-- Panel header -->
        <div class="flex items-center gap-2.5 px-4 py-3" style="background:#071426; border-bottom:var(--pop-border-thin)">
          <div class="flex gap-1.5">
            <span class="w-3 h-3 rounded-full bg-accent" style="border:1.5px solid #000"></span>
            <span class="w-3 h-3 rounded-full bg-[#ffbd2e]" style="border:1.5px solid #000"></span>
            <span class="w-3 h-3 rounded-full bg-primary" style="border:1.5px solid #000"></span>
          </div>
          <span class="ml-auto font-mono text-xs font-extrabold text-slate-400 tracking-widest uppercase">pages/index.kiw</span>
        </div>
        <!-- Code -->
        <pre class="m-0 px-4 sm:px-5 py-4 sm:py-5 overflow-x-auto font-mono text-xs sm:text-sm leading-relaxed" style="color:#FAF8F4"><code><span style="color:#64748b;font-style:italic">---</span>
<span style="color:#00D1C1;font-weight:700">title:</span> "Welcome to Krewire"
<span style="color:#00D1C1;font-weight:700">layout:</span> Landing
<span style="color:#64748b;font-style:italic">---</span>

<span style="color:#39D353;font-weight:700">&lt;section class="welcome"&gt;</span>
  <span style="color:#39D353;font-weight:700">&lt;h1&gt;</span>{{"{{"}} .Title {{"}}"}}<span style="color:#39D353;font-weight:700">&lt;/h1&gt;</span>
  <span style="color:#39D353;font-weight:700">&lt;p&gt;</span>Compiled Go speed with zero runtime bloat.<span style="color:#39D353;font-weight:700">&lt;/p&gt;</span>
<span style="color:#39D353;font-weight:700">&lt;/section&gt;</span>

<span style="color:#39D353;font-weight:700">&lt;style&gt;</span>
.welcome { padding: 40px 0; text-align: center; }
h1 { color: var(--primary); font-weight: 900; }
p  { font-size: 15px; color: var(--muted); }
<span style="color:#39D353;font-weight:700">&lt;/style&gt;</span></code></pre>
        <!-- Panel footer -->
        <div class="flex flex-wrap gap-2.5 px-4 py-4" style="background:#071426; border-top:1.5px solid rgba(255,255,255,0.1)">
          <Button Variant="primary" Size="sm" Href="/getting-started/dsl">Explore DSL Syntax →</Button>
          <Button Variant="outline" Size="sm" Href="/getting-started">Read the Docs</Button>
        </div>
      </div>

      <!-- Feature panel -->
      <div class="card">
        <div class="mb-4">
          <span class="badge badge-secondary mb-2">Scoping</span>
          <h3 class="text-xl font-black tracking-tight mt-2 text-fg dark:text-fg-dark">Why Scoped CSS in Go?</h3>
        </div>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed mb-5">
          Every <code class="code-inline">.kiw</code> component receives automatic <code class="code-inline">data-kiw-component</code> scope hashing at build time. No CSS collisions, no naming gymnastics, zero runtime cost.
        </p>
        <ul class="flex flex-col gap-3 p-0 m-0 list-none">
          <li class="flex items-start gap-2.5 text-sm text-muted dark:text-muted-dark leading-snug">
            <span class="text-primary font-black text-base shrink-0 leading-tight">✓</span>
            <span data-i18n-html="dsl.f1_html"><b class="text-fg dark:text-fg-dark">Scoped by Default:</b> Styles remain strictly isolated to the component.</span>
          </li>
          <li class="flex items-start gap-2.5 text-sm text-muted dark:text-muted-dark leading-snug">
            <span class="text-primary font-black text-base shrink-0 leading-tight">✓</span>
            <span data-i18n-html="dsl.f2_html"><b class="text-fg dark:text-fg-dark">Global CSS via <code class="code-inline">:root</code>:</b> Theme tokens cascade cleanly across layouts.</span>
          </li>
          <li class="flex items-start gap-2.5 text-sm text-muted dark:text-muted-dark leading-snug">
            <span class="text-primary font-black text-base shrink-0 leading-tight">✓</span>
            <span data-i18n-html="dsl.f3_html"><b class="text-fg dark:text-fg-dark">Built into <code class="code-inline">kiw</code>:</b> Compiled natively via <code class="code-inline">kiw/dsl</code> with zero npm or external bundler dependencies.</span>
          </li>
          <li class="flex items-start gap-2.5 text-sm text-muted dark:text-muted-dark leading-snug">
            <span class="text-primary font-black text-base shrink-0 leading-tight">✓</span>
            <span data-i18n-html="dsl.f4_html"><b class="text-fg dark:text-fg-dark">Light & Dark Mode:</b> Native token switching via <code class="code-inline">data-theme</code>.</span>
          </li>
        </ul>
      </div>

    </div>
  </div>
</section>

