<!-- =====================================================================
     FOUR STEPS
     ===================================================================== -->
<section class="w-full bg-bg-2 dark:bg-bg-dark-2 bg-dots py-28 sm:py-36 md:py-40 lg:py-44 border-b-2 border-border">
  <div class="container-site">
    <div class="text-center max-w-2xl mx-auto mb-14 sm:mb-20">
      <Badge Variant="primary" Class="mb-3 sm:mb-4"><span data-i18n="steps.badge">Developer Workflow</span></Badge>
      <h2 class="text-3xl sm:text-4xl font-black tracking-tight mb-4 sm:mb-5 text-fg dark:text-fg-dark" data-i18n="steps.title">From Zero to Production in 4 Steps</h2>
      <p class="text-sm sm:text-base text-muted dark:text-muted-dark leading-relaxed" data-i18n="steps.lead">Install once, then scaffold, develop, and deploy — no toolchain fatigue, no breaking dependency trees.</p>
    </div>

    <!-- Pipeline Timeline Container -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 relative">

      <!-- Step 1: Install -->
      <div class="card flex flex-col justify-between p-6 sm:p-7 md:p-8 bg-bg dark:bg-bg-dark relative hover:-translate-y-1 transition-all duration-150">
        <div>
          <div class="flex items-center justify-between gap-2 mb-5">
            <span class="w-10 h-10 rounded-xl bg-primary text-primary-content flex items-center justify-center font-black text-sm border-2 border-border shadow-[2px_2px_0px_var(--border)]">01</span>
            <Badge Variant="primary" Size="sm" Class="font-mono"><span data-i18n="steps.s1_badge">Install</span></Badge>
          </div>
          <h3 class="text-lg font-black tracking-tight mb-2.5 text-fg dark:text-fg-dark">install.sh</h3>
          <p class="text-xs sm:text-sm text-muted dark:text-muted-dark leading-relaxed mb-6" data-i18n="steps.s1_desc">One command installs the <code class="code-inline">kiw</code> CLI on Linux or macOS. No package manager needed.</p>
        </div>
        <Terminal Command="curl -fsSL https://krewire.com/scripts/install.sh | sh" Class="mt-6 sm:mt-8 w-full" />
      </div>

      <!-- Step 2: Scaffold -->
      <div class="card flex flex-col justify-between p-6 sm:p-7 md:p-8 bg-bg dark:bg-bg-dark relative hover:-translate-y-1 transition-all duration-150">
        <div>
          <div class="flex items-center justify-between gap-2 mb-5">
            <span class="w-10 h-10 rounded-xl bg-primary text-primary-content flex items-center justify-center font-black text-sm border-2 border-border shadow-[2px_2px_0px_var(--border)]">02</span>
            <Badge Variant="primary" Size="sm" Class="font-mono"><span data-i18n="steps.s2_badge">Scaffold</span></Badge>
          </div>
          <h3 class="text-lg font-black tracking-tight mb-2.5 text-fg dark:text-fg-dark">kiw new</h3>
          <p class="text-xs sm:text-sm text-muted dark:text-muted-dark leading-relaxed mb-6" data-i18n="steps.s2_desc">Generate a production-ready project template for any workload in under one second.</p>
        </div>
        <Terminal Command="kiw new my-site --site && cd my-site" Class="mt-6 sm:mt-8 w-full" />
      </div>

      <!-- Step 3: Develop -->
      <div class="card flex flex-col justify-between p-6 sm:p-7 md:p-8 bg-bg dark:bg-bg-dark relative hover:-translate-y-1 transition-all duration-150">
        <div>
          <div class="flex items-center justify-between gap-2 mb-5">
            <span class="w-10 h-10 rounded-xl bg-primary text-primary-content flex items-center justify-center font-black text-sm border-2 border-border shadow-[2px_2px_0px_var(--border)]">03</span>
            <Badge Variant="primary" Size="sm" Class="font-mono"><span data-i18n="steps.s3_badge">Develop</span></Badge>
          </div>
          <h3 class="text-lg font-black tracking-tight mb-2.5 text-fg dark:text-fg-dark">kiw dev</h3>
          <p class="text-xs sm:text-sm text-muted dark:text-muted-dark leading-relaxed mb-6" data-i18n="steps.s3_desc">Instant hot-reload local development server with file-based routing and scoped CSS updates.</p>
        </div>
        <Terminal Command="kiw dev" Class="mt-6 sm:mt-8 w-full" />
      </div>

      <!-- Step 4: Deploy -->
      <div class="card flex flex-col justify-between p-6 sm:p-7 md:p-8 bg-bg dark:bg-bg-dark relative hover:-translate-y-1 transition-all duration-150">
        <div>
          <div class="flex items-center justify-between gap-2 mb-5">
            <span class="w-10 h-10 rounded-xl bg-primary text-primary-content flex items-center justify-center font-black text-sm border-2 border-border shadow-[2px_2px_0px_var(--border)]">04</span>
            <Badge Variant="primary" Size="sm" Class="font-mono"><span data-i18n="steps.s4_badge">Deploy</span></Badge>
          </div>
          <h3 class="text-lg font-black tracking-tight mb-2.5 text-fg dark:text-fg-dark">kiw deploy</h3>
          <p class="text-xs sm:text-sm text-muted dark:text-muted-dark leading-relaxed mb-6" data-i18n="steps.s4_desc">Compile into a single static binary or static asset bundle and ship to GitHub Pages or Docker.</p>
        </div>
        <Terminal Command="kiw deploy --target gh-pages" Class="mt-6 sm:mt-8 w-full" />
      </div>

    </div>
  </div>
</section>

<!-- =====================================================================
     WHY KREWIRE
     ===================================================================== -->
<section class="w-full bg-bg dark:bg-bg-dark py-28 sm:py-36 md:py-40 lg:py-44 border-b-2 border-border">
  <div class="container-site">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 xl:gap-16 items-start">

      <!-- Left Column: Metrics & Philosophy (5 cols) -->
      <div class="lg:col-span-5">
        <Badge Variant="primary" Class="mb-3 sm:mb-4"><span data-i18n="why.badge">Architecture &amp; Philosophy</span></Badge>
        <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-fg dark:text-fg-dark mb-4 sm:mb-5" data-i18n="why.title">Go-First. Progressive. Zero Bloat.</h2>
        <p class="text-sm sm:text-base text-muted dark:text-muted-dark leading-relaxed mb-6 sm:mb-8" data-i18n="why.lead">
          Built for engineers who value compilation speed, predictable deployments, and maintainable software architecture. One unified toolchain eliminates JavaScript fatigue entirely.
        </p>

        <!-- 2x2 Metric Matrix using Stat components -->
        <div class="grid grid-cols-2 gap-4 sm:gap-5 mb-6">
          <Stat label="Dependencies" value="0" unit="npm" subtitle="Zero Node runtime" />
          <Stat label="Cold Starts" value="< 1" unit="ms" subtitle="Instant response" />
          <Stat label="RAM Footprint" value="10–30" unit="MB" subtitle="Runs on $5 VPS" />
          <Stat label="Pure Go" value="100%" unit="Pure Go" subtitle="Zero CGO required" />
        </div>
      </div>

      <!-- Right Column: Numbered Architectural Feature Stack (7 cols) -->
      <div class="lg:col-span-7 flex flex-col gap-5 sm:gap-6">

        <div class="card p-6 sm:p-7 bg-bg-2 dark:bg-bg-dark-2 flex items-start gap-4 sm:gap-5 hover:-translate-y-1 transition-all duration-150">
          <span class="icon-box bg-primary text-primary-content text-base w-9 h-9 shrink-0 flex items-center justify-center font-bold">◈</span>
          <div>
            <h3 class="text-base sm:text-lg font-black tracking-tight mb-1.5 text-fg dark:text-fg-dark" data-i18n="why.w1_title">Pure Go Toolchain</h3>
            <p class="text-xs sm:text-sm text-muted dark:text-muted-dark leading-relaxed m-0" data-i18n="why.w1_desc">No Node.js, no npm dependencies, and no bundler configuration. Your entire application compiles with standard Go tooling into clean, self-contained binaries.</p>
          </div>
        </div>

        <div class="card p-6 sm:p-7 bg-bg-2 dark:bg-bg-dark-2 flex items-start gap-4 sm:gap-5 hover:-translate-y-1 transition-all duration-150">
          <span class="icon-box bg-primary text-primary-content text-base w-9 h-9 shrink-0 flex items-center justify-center font-bold">◧</span>
          <div>
            <h3 class="text-base sm:text-lg font-black tracking-tight mb-1.5 text-fg dark:text-fg-dark" data-i18n="why.w2_title">Scoped .kiw Components</h3>
            <p class="text-xs sm:text-sm text-muted dark:text-muted-dark leading-relaxed m-0" data-i18n="why.w2_desc">Combines YAML frontmatter, standard Go HTML templates, and scoped <code class="code-inline">&lt;style&gt;</code> blocks. CSS classes never leak outside their component boundary.</p>
          </div>
        </div>

        <div class="card p-6 sm:p-7 bg-bg-2 dark:bg-bg-dark-2 flex items-start gap-4 sm:gap-5 hover:-translate-y-1 transition-all duration-150">
          <span class="icon-box bg-primary text-primary-content text-base w-9 h-9 shrink-0 flex items-center justify-center font-bold">⚡</span>
          <div>
            <h3 class="text-base sm:text-lg font-black tracking-tight mb-1.5 text-fg dark:text-fg-dark" data-i18n="why.w3_title">Progressive Scaling</h3>
            <p class="text-xs sm:text-sm text-muted dark:text-muted-dark leading-relaxed m-0" data-i18n="why.w3_desc">Start as a lightweight static site, grow into a fullstack web monolith, then seamlessly extract background workers and microservices — all within the same ecosystem.</p>
          </div>
        </div>

        <div class="card p-6 sm:p-7 bg-bg-2 dark:bg-bg-dark-2 flex items-start gap-4 sm:gap-5 hover:-translate-y-1 transition-all duration-150">
          <span class="icon-box bg-primary text-primary-content text-base w-9 h-9 shrink-0 flex items-center justify-center font-bold">🛡</span>
          <div>
            <h3 class="text-base sm:text-lg font-black tracking-tight mb-1.5 text-fg dark:text-fg-dark" data-i18n="why.w4_title">Enterprise Resilience</h3>
            <p class="text-xs sm:text-sm text-muted dark:text-muted-dark leading-relaxed m-0" data-i18n="why.w4_desc">Engineered with production defaults: structured JSON logging, distributed tracing, health checks, circuit breakers, and graceful shutdown out of the box.</p>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<!-- =====================================================================
     DSL SHOWCASE
     ===================================================================== -->
<section class="w-full bg-bg-2 dark:bg-bg-dark-2 bg-dots py-28 sm:py-36 md:py-40 lg:py-44 border-b-2 border-border">
  <div class="container-site">
    <div class="text-center max-w-2xl mx-auto mb-14 sm:mb-20">
      <Badge Variant="primary" Class="mb-3 sm:mb-4"><span data-i18n="dsl.badge">Component DSL</span></Badge>
      <h2 class="text-3xl sm:text-4xl font-black tracking-tight mb-4 sm:mb-5 text-fg dark:text-fg-dark" data-i18n="dsl.title">Write Pages as Clean .kiw Components</h2>
      <p class="text-sm sm:text-base text-muted dark:text-muted-dark leading-relaxed" data-i18n="dsl.lead">The elegance of Svelte and Astro brought to Go. Frontmatter + HTML + scoped CSS in one intuitive file.</p>
    </div>

    <!-- Grid: 1 col on mobile/sm → 2 col on md/lg -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10 lg:gap-12 items-start">

      <!-- Code panel -->
      <div class="code-window w-full rounded-xl overflow-hidden min-w-0" style="background:#0B1F3B; border:var(--pop-border); box-shadow:var(--pop-shadow-lg)" data-kiw-component="CodeWindow">
        <!-- Panel header -->
        <div class="flex items-center gap-2.5 px-4 sm:px-5 py-3 sm:py-3.5" style="background:#071426; border-bottom:var(--pop-border-thin)">
          <div class="flex gap-1.5">
            <span class="w-3 h-3 rounded-full bg-accent" style="border:1.5px solid #000"></span>
            <span class="w-3 h-3 rounded-full bg-[#ffbd2e]" style="border:1.5px solid #000"></span>
            <span class="w-3 h-3 rounded-full bg-primary" style="border:1.5px solid #000"></span>
          </div>
          <span class="ml-2 font-mono text-xs font-extrabold text-slate-400 tracking-widest uppercase">pages/index.kiw</span>
          <button type="button" class="btn-copy-code ml-auto font-mono text-[11px] font-extrabold px-3 py-1 rounded-md bg-white/10 text-white border border-white/20 hover:bg-primary hover:text-[#0B1F3B] hover:border-primary transition-all duration-150 cursor-pointer" onclick="copyCodeWindow(this)">Copy</button>
        </div>
        <!-- Code -->
        <pre class="code-window-pre m-0 px-4 sm:px-6 py-5 sm:py-6 overflow-x-auto font-mono text-xs sm:text-sm leading-relaxed" style="color:#FAF8F4"><code class="code-window-code"><span style="color:#64748b;font-style:italic">---</span>
<span style="color:#00D1C1;font-weight:700">title:</span> "Welcome to Krewire"
<span style="color:#00D1C1;font-weight:700">layout:</span> Landing
<span style="color:#64748b;font-style:italic">---</span>

<span style="color:#39D353;font-weight:700">&lt;section class="welcome"&gt;</span>
  <span style="color:#39D353;font-weight:700">&lt;h1&gt;</span>&lbrace;title&rbrace;<span style="color:#39D353;font-weight:700">&lt;/h1&gt;</span>
  <span style="color:#39D353;font-weight:700">&lt;p&gt;</span>Compiled Go speed with zero runtime bloat.<span style="color:#39D353;font-weight:700">&lt;/p&gt;</span>
<span style="color:#39D353;font-weight:700">&lt;/section&gt;</span>

<span style="color:#39D353;font-weight:700">&lt;style&gt;</span>
.welcome { padding: 40px 0; text-align: center; }
h1 { color: var(--primary); font-weight: 900; }
p  { font-size: 15px; color: var(--muted); }
<span style="color:#39D353;font-weight:700">&lt;/style&gt;</span></code></pre>
        <!-- Panel footer -->
        <div class="flex flex-wrap gap-3 px-4 sm:px-6 py-4 sm:py-5" style="background:#071426; border-top:1.5px solid rgba(255,255,255,0.1)">
          <Button Variant="primary" Size="sm" Href="/docs/getting-started/dsl"><span data-i18n="dsl.cta_explore">Explore DSL Syntax →</span></Button>
          <Button Variant="outline" Size="sm" Href="/docs/getting-started"><span data-i18n="dsl.cta_docs">Read the Docs</span></Button>
        </div>
      </div>

      <!-- Feature panel -->
      <div class="card p-7 sm:p-8 md:p-9 bg-bg dark:bg-bg-dark">
        <div class="mb-4">
          <Badge Variant="primary" Class="mb-2"><span data-i18n="dsl.scoping_badge">Scoping</span></Badge>
          <h3 class="text-xl sm:text-2xl font-black tracking-tight mt-2 text-fg dark:text-fg-dark" data-i18n="dsl.scoping_title">Why Scoped CSS in Go?</h3>
        </div>
        <ul class="flex flex-col gap-3.5 p-0 m-0 list-none">
          <li class="flex items-start gap-3 text-sm sm:text-base text-muted dark:text-muted-dark leading-snug">
            <span class="text-primary font-black text-base shrink-0 leading-tight">✓</span>
            <span data-i18n-html="dsl.f1_html"><b class="text-fg dark:text-fg-dark">Scoped by Default:</b> Styles remain strictly isolated to the component.</span>
          </li>
          <li class="flex items-start gap-3 text-sm sm:text-base text-muted dark:text-muted-dark leading-snug">
            <span class="text-primary font-black text-base shrink-0 leading-tight">✓</span>
            <span data-i18n-html="dsl.f2_html"><b class="text-fg dark:text-fg-dark">Global CSS via <code class="code-inline">:root</code>:</b> Theme tokens cascade cleanly across layouts.</span>
          </li>
          <li class="flex items-start gap-3 text-sm sm:text-base text-muted dark:text-muted-dark leading-snug">
            <span class="text-primary font-black text-base shrink-0 leading-tight">✓</span>
            <span data-i18n-html="dsl.f3_html"><b class="text-fg dark:text-fg-dark">Built into <code class="code-inline">kiw</code>:</b> Compiled natively via <code class="code-inline">kiw/dsl</code> with zero npm or external bundler dependencies.</span>
          </li>
          <li class="flex items-start gap-3 text-sm sm:text-base text-muted dark:text-muted-dark leading-snug">
            <span class="text-primary font-black text-base shrink-0 leading-tight">✓</span>
            <span data-i18n-html="dsl.f4_html"><b class="text-fg dark:text-fg-dark">Light & Dark Mode:</b> Native token switching via <code class="code-inline">data-theme</code>.</span>
          </li>
        </ul>
      </div>

    </div>
  </div>
</section>

